  document.addEventListener('DOMContentLoaded', () => {
    const pillText = document.getElementById('pill-text');
    
    // Hardware Stages on Left
    const hwStageGoogle = document.getElementById('hw-stage-google');
    const hwStageCard = document.getElementById('hw-stage-card');
    const hwStageMenu = document.getElementById('hw-stage-menu');

    // Dynamic Product Value Boxes (Descripción, Para qué sirve, Cómo impulsa el negocio)
    const infoGoogle = document.getElementById('info-google');
    const infoCard = document.getElementById('info-card');
    const infoMenu = document.getElementById('info-menu');

    // Screens in Phone on Right
    const screenVcard = document.getElementById('screen-vcard');
    const screenGoogle = document.getElementById('screen-google');
    const screenMenu = document.getElementById('screen-menu');

    // Category Buttons
    const btnGoogle = document.getElementById('btn-simulate-google-tap');
    const btnVcard = document.getElementById('btn-simulate-card-tap');
    const btnMenu = document.getElementById('btn-simulate-menu-tap');

    // Stand Tap Action
    const btnStandTapAction = document.getElementById('btn-stand-tap-action');

    // Card Front / Back Elements
    const btnPageCardFront = document.getElementById('btn-page-card-front');
    const btnPageCardBack = document.getElementById('btn-page-card-back');
    const pageCardFaceFront = document.getElementById('page-card-face-front');
    const pageCardFaceBack = document.getElementById('page-card-face-back');

    // Helper to flash dynamic island
    function triggerNfcPulse(label: string) {
      if (pillText) {
        pillText.textContent = label;
        pillText.className = "text-[8px] text-emerald-400 font-extrabold animate-ping";
        setTimeout(() => {
          pillText.className = "text-[8px] text-amber-300 font-bold";
        }, 600);
      }
    }

    function setActiveBtn(activeBtn) {
      [btnGoogle, btnVcard, btnMenu].forEach(b => {
        if (!b) return;
        b.className = "py-2.5 px-3 rounded-xl bg-[#121216] hover:bg-[#181822] text-amber-300 border border-amber-500/50 hover:border-amber-400 font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer";
      });
      if (activeBtn) {
        activeBtn.className = "py-2.5 px-3 rounded-xl bg-gradient-to-r from-amber-500 to-yellow-600 text-slate-950 font-black hover:from-amber-600 hover:to-yellow-700 transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-sm";
      }
    }

    function resetHwStages() {
      [hwStageGoogle, hwStageCard, hwStageMenu].forEach(st => st?.classList.add('hidden'));
    }

    function resetInfoBoxes() {
      [infoGoogle, infoCard, infoMenu].forEach(info => info?.classList.add('hidden'));
    }

    // Tap Scenario 1: Google 5★ Review (DEFAULT)
    function activateGoogleReview() {
      triggerNfcPulse("⭐ GOOGLE 5★");
      setActiveBtn(btnGoogle);
      resetHwStages();
      resetInfoBoxes();
      infoGoogle?.classList.remove('hidden');
      hwStageGoogle?.classList.remove('hidden');
      screenGoogle?.classList.remove('hidden');
      screenVcard?.classList.add('hidden');
      screenMenu?.classList.add('hidden');
    }

    btnGoogle?.addEventListener('click', activateGoogleReview);
    btnStandTapAction?.addEventListener('click', activateGoogleReview);

    // Tap Scenario 2: vCard / Tarjeta PVC
    function activateVcard() {
      triggerNfcPulse("⚡ NFC: VCARD");
      setActiveBtn(btnVcard);
      resetHwStages();
      resetInfoBoxes();
      infoCard?.classList.remove('hidden');
      hwStageCard?.classList.remove('hidden');
      screenVcard?.classList.remove('hidden');
      screenGoogle?.classList.add('hidden');
      screenMenu?.classList.add('hidden');
    }

    btnVcard?.addEventListener('click', activateVcard);

    // Tap Scenario 3: Restaurant Menu
    function activateMenu() {
      triggerNfcPulse("🍽️ QR: MENÚ MESA");
      setActiveBtn(btnMenu);
      resetHwStages();
      resetInfoBoxes();
      infoMenu?.classList.remove('hidden');
      hwStageMenu?.classList.remove('hidden');
      screenMenu?.classList.remove('hidden');
      screenVcard?.classList.add('hidden');
      screenGoogle?.classList.add('hidden');
    }

    btnMenu?.addEventListener('click', activateMenu);

    // Card Front / Back Toggle
    btnPageCardFront?.addEventListener('click', () => {
      pageCardFaceFront?.classList.remove('hidden');
      pageCardFaceBack?.classList.add('hidden');
      btnPageCardFront?.classList.add('bg-gradient-to-r', 'from-amber-500', 'to-yellow-600', 'text-slate-950', 'font-black');
      btnPageCardFront?.classList.remove('text-zinc-400');
      btnPageCardBack?.classList.remove('bg-gradient-to-r', 'from-amber-500', 'to-yellow-600', 'text-slate-950', 'font-black');
      btnPageCardBack?.classList.add('text-zinc-400');
    });

    btnPageCardBack?.addEventListener('click', () => {
      pageCardFaceFront?.classList.add('hidden');
      pageCardFaceBack?.classList.remove('hidden');
      btnPageCardBack?.classList.add('bg-gradient-to-r', 'from-amber-500', 'to-yellow-600', 'text-slate-950', 'font-black');
      btnPageCardBack?.classList.remove('text-zinc-400');
      btnPageCardFront?.classList.remove('bg-gradient-to-r', 'from-amber-500', 'to-yellow-600', 'text-slate-950', 'font-black');
      btnPageCardFront?.classList.add('text-zinc-400');
    });

    // Showcase Video Scroll Trigger & Audio Controls (Inicia al bajar a visualizar, pausa al salir)
    const showcaseVideo = document.getElementById('showcase-video') as HTMLVideoElement | null;
    const btnUnmute = document.getElementById('btn-unmute-video');
    const soundToggleIcon = document.getElementById('sound-toggle-icon');
    const soundToggleLabel = document.getElementById('sound-toggle-label');

    let userManuallyMuted = false;

    function updateAudioUI(isMuted: boolean) {
      if (soundToggleIcon && soundToggleLabel) {
        if (isMuted) {
          soundToggleIcon.textContent = "🔇";
          soundToggleLabel.textContent = "Activar Audio";
          if (btnUnmute) {
            btnUnmute.className = "inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-zinc-800/80 hover:bg-zinc-700/80 border border-zinc-600 text-zinc-300 font-mono text-xs font-bold transition-all cursor-pointer shadow-sm";
          }
        } else {
          soundToggleIcon.textContent = "🔊";
          soundToggleLabel.textContent = "Silenciar Audio";
          if (btnUnmute) {
            btnUnmute.className = "inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/50 text-amber-300 font-mono text-xs font-bold transition-all cursor-pointer shadow-sm";
          }
        }
      }
    }

    if (showcaseVideo) {
      showcaseVideo.volume = 0.5; // Volumen medio inicial (50%)

      // Iniciar IntersectionObserver para auto-reproducir al bajar a la sección y pausar al salir
      const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // El usuario bajó a ver el video: iniciar con volumen medio
            if (!userManuallyMuted) {
              showcaseVideo.muted = false;
              showcaseVideo.volume = 0.5;
            }
            showcaseVideo.play().then(() => {
              updateAudioUI(showcaseVideo.muted);
            }).catch(() => {
              // Si la política de autoplay del navegador exige interacción táctil/clic previa:
              showcaseVideo.muted = true;
              showcaseVideo.play().catch(() => {});
              updateAudioUI(true);

              const unmuteOnInteraction = () => {
                if (!userManuallyMuted && showcaseVideo) {
                  showcaseVideo.muted = false;
                  showcaseVideo.volume = 0.5;
                  updateAudioUI(false);
                }
                ['click', 'touchstart', 'scroll'].forEach(ev => {
                  window.removeEventListener(ev, unmuteOnInteraction);
                });
              };
              ['click', 'touchstart', 'scroll'].forEach(ev => {
                window.addEventListener(ev, unmuteOnInteraction, { once: true });
              });
            });
          } else {
            // El usuario se desplazó fuera de la vista: pausar video
            if (!showcaseVideo.paused) {
              showcaseVideo.pause();
            }
          }
        });
      }, {
        threshold: 0.30 // Se activa cuando al menos el 30% del video está visible en pantalla
      });

      videoObserver.observe(showcaseVideo);
    }

    btnUnmute?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!showcaseVideo) return;
      if (showcaseVideo.muted) {
        userManuallyMuted = false;
        showcaseVideo.muted = false;
        showcaseVideo.volume = 0.5;
        updateAudioUI(false);
        showcaseVideo.play().catch(() => {});
      } else {
        userManuallyMuted = true;
        showcaseVideo.muted = true;
        updateAudioUI(true);
      }
    });
  });
</script>
