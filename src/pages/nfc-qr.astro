---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { companyData } from '../data/company';

const phone = companyData.whatsappNumber || '';
const baseWa = phone ? `https://api.whatsapp.com/send?phone=${phone}&text=` : `https://api.whatsapp.com/send?text=`;
const waMsgNfc = encodeURIComponent("¡Hola equipo de PalkioTech! 👋 Me interesa cotizar para mi negocio: [ ] Stand de reseñas Google 5★ / [ ] Tarjetas NFC en PVC / [ ] QR para menú o redes. ¿Podrían brindarme información de precios y personalización por favor?");
---

<Layout 
  title="PalkioTag™ · Stands NFC & QR para Reseñas de Google 5★ y Tarjetas Ejecutivas | PalkioTech"
  description="Multiplica tus reseñas de 5 estrellas en Google Maps y digitaliza la presencia física de tu empresa en 1 toque con PalkioTag™: stands acrílicos de mostrador y tarjetas inteligentes NFC."
>
  <Navbar />

  <main class="bg-[#060709] text-white min-h-screen selection:bg-amber-500/30 selection:text-amber-200" data-page-theme="dark">
    
    <!-- Hero Breadcrumb & Header -->
    <section class="pt-10 pb-16 relative overflow-hidden border-b border-[#1a1a22]" data-navbar-theme="dark">
      <!-- Ambient Glows -->
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[900px] h-[450px] bg-gradient-to-b from-amber-500/15 via-yellow-500/10 to-transparent blur-3xl pointer-events-none"></div>
      <div class="absolute inset-0 bg-[radial-gradient(#202028_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Breadcrumb Navigation -->
        <nav class="flex items-center gap-2 text-xs font-mono text-zinc-400 mb-8">
          <a href="/" class="hover:text-amber-400 transition-colors">Inicio</a>
          <span>/</span>
          <span class="text-zinc-500">Soluciones Phygital</span>
          <span>/</span>
          <span class="text-amber-400 font-bold">PalkioTag™ (Google 5★ & NFC)</span>
        </nav>

        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-950/80 border border-amber-700/60 text-amber-300 text-xs font-mono font-bold mb-6 shadow-sm">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
            <span>✦ PALKIOTAG™ · HARDWARE PHYGITAL DE RESEÑAS GOOGLE 5★</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight mb-6 leading-[1.15]">
            PalkioTag™: <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-500">Reseñas de Google 5★</span> & Tarjetas NFC en 1 Toque
          </h1>

          <p class="text-base sm:text-lg text-zinc-300 font-normal leading-relaxed mb-8 max-w-3xl mx-auto">
            Multiplica tus opiniones positivas en Google Maps de forma instantánea. Tus clientes solo tienen que acercar su smartphone al stand de mostrador <strong>PalkioTag Review™</strong> para calificar con 5 estrellas en segundos, sin aplicaciones ni búsquedas manuales.
          </p>

          <!-- Action CTAs -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto mb-10">
            <a 
              href="#simulador" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-xl bg-gradient-to-r from-amber-400 via-amber-500 to-yellow-500 hover:from-amber-500 hover:to-yellow-600 text-slate-950 font-black shadow-lg shadow-amber-500/25 transition-all text-sm hover:scale-105"
            >
              <span>Probar Simulador Interactivo ↓</span>
            </a>

            <a 
              href="#video-demo" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#121216] hover:bg-[#181822] text-amber-300 border border-amber-500/40 hover:border-amber-400 font-bold transition-all text-sm hover:scale-105"
            >
              <span>▶ Ver Video Real en Acción</span>
            </a>

            <a 
              href={`${baseWa}${waMsgNfc}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#121216] hover:bg-[#181822] text-emerald-400 border border-emerald-800/60 font-bold transition-all text-sm"
            >
              <span>💬 Consultar por WhatsApp</span>
            </a>
          </div>

          <!-- Feature Highlights Bar -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-left pt-6 border-t border-[#1e1e26]">
            <div class="p-3.5 rounded-2xl bg-[#0c0c10] border border-[#202028]">
              <span class="text-amber-400 font-bold font-mono text-xs block mb-0.5">⚡ 1-Tap Touch</span>
              <span class="text-zinc-400 text-[11px] leading-tight block">0 aplicaciones requeridas para quien escanea.</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-[#0c0c10] border border-[#202028]">
              <span class="text-amber-400 font-bold font-mono text-xs block mb-0.5">🔐 Chip NTAG216</span>
              <span class="text-zinc-400 text-[11px] leading-tight block">888 bytes para vCard completa y links múltiples.</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-[#0c0c10] border border-[#202028]">
              <span class="text-amber-400 font-bold font-mono text-xs block mb-0.5">🔄 Doble Propósito</span>
              <span class="text-zinc-400 text-[11px] leading-tight block">Chip NFC al frente + código QR dinámico al reverso.</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-[#0c0c10] border border-[#202028]">
              <span class="text-amber-400 font-bold font-mono text-xs block mb-0.5">✨ 100% Personalizable</span>
              <span class="text-zinc-400 text-[11px] leading-tight block">Con tu logotipo, colores y adaptado a lo que necesites.</span>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- ==============================================
         MAIN INTERACTIVE SHOWCASE (CARD & PHONE SIMULATOR)
         ============================================== -->
    <section id="simulador" class="py-20 relative overflow-hidden" data-navbar-theme="dark">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <div class="max-w-3xl mx-auto text-center mb-12">
          <span class="text-xs font-mono font-bold text-amber-400 uppercase tracking-wider block mb-2">✦ LABORATORIO DIGITAL INTERACTIVO</span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
            Experimenta el Flujo Físico y Digital en Tiempo Real
          </h2>
          <p class="text-zinc-400 text-sm mt-2">
            Selecciona un producto para conocer su funcionamiento, impacto comercial en tu negocio y simular en tiempo real cómo interactúa el smartphone de tu cliente.
          </p>
        </div>

        <div class="bg-[#0d0d12] p-6 sm:p-10 rounded-3xl border border-[#22222a] shadow-2xl backdrop-blur-xl space-y-8">
          
          <!-- TOP: TITLE BAR & PRODUCT SELECTOR (FULL WIDTH) -->
          <div class="space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-[#22222a] text-xs font-mono">
              <span class="text-zinc-400 font-bold uppercase tracking-wider">Simulador de Hardware Físico PalkioTag™</span>
              <span class="text-amber-400 font-bold flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Chip NTAG216 Activo
              </span>
            </div>

            <!-- Product Category Selector -->
            <div>
              <label class="block text-xs font-mono font-bold text-zinc-300 mb-2 uppercase">
                1. Selecciona el Producto Phygital a Simular:
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono font-bold">
                <button 
                  type="button" 
                  id="btn-simulate-google-tap"
                  class="py-2.5 px-3 rounded-xl bg-gradient-to-r from-amber-500 to-yellow-600 text-slate-950 font-black hover:from-amber-600 hover:to-yellow-700 transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-sm"
                >
                  <span>⭐ Stand Google 5★</span>
                </button>
                <button 
                  type="button" 
                  id="btn-simulate-card-tap"
                  class="py-2.5 px-3 rounded-xl bg-[#121216] hover:bg-[#181822] text-amber-300 border border-amber-500/50 hover:border-amber-400 font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer"
                >
                  <span>🪪 Tarjeta PVC</span>
                </button>
                <button 
                  type="button" 
                  id="btn-simulate-menu-tap"
                  class="py-2.5 px-3 rounded-xl bg-[#121216] hover:bg-[#181822] text-emerald-400 border border-emerald-600/50 hover:border-emerald-500 font-bold transition-all flex items-center justify-center gap-1.5 cursor-pointer"
                >
                  <span>🍽️ Menú / QR Mesa</span>
                </button>
              </div>
            </div>
          </div>

          <!-- MIDDLE: HARDWARE FÍSICO Y DISPOSITIVO SMARTPHONE A LA PAR (SIDE-BY-SIDE) -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center justify-items-center py-2">
            
            <!-- LEFT: CUSTOMIZABLE NFC HARDWARE PREVIEW -->
            <div class="w-full max-w-[360px] flex flex-col items-center justify-center space-y-4">
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 font-mono text-[10px] font-bold uppercase tracking-wider">
                <span>✦</span> Diseño Físico Personalizado
              </div>

              <!-- STAGE 1: STAND ACRÍLICO GOOGLE 5★ (DEFAULT) -->
              <div id="hw-stage-google" class="w-full space-y-4">
                
                <!-- Stand Card Body -->
                <div class="relative w-full max-w-[330px] mx-auto rounded-3xl overflow-hidden border-2 border-amber-400/70 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.95),0_0_35px_rgba(212,175,55,0.25)] select-none bg-white">
                  
                  <!-- TOP WHITE SECTION -->
                  <div class="p-6 pt-5 text-center relative bg-white">
                    
                    <!-- 5 Gold Stars at the very top -->
                    <div class="flex items-center justify-center gap-1.5 text-amber-400 text-2xl drop-shadow-xs mb-1">
                      <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
                    </div>

                    <!-- Subtitle -->
                    <p class="text-slate-600 text-[11px] font-semibold tracking-wide">
                      ¿Te encantó tu experiencia?
                    </p>

                    <!-- Big Bold Black Headline -->
                    <h3 class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight leading-[1.08] my-1 uppercase">
                      CALIFÍCANOS<br />EN GOOGLE
                    </h3>

                    <!-- CENTER LOGO: PALKIOTECH -->
                    <div class="my-2.5 flex flex-col items-center justify-center">
                      <img src="/images/palkiotech-emblem.png" alt="PalkioTech" class="h-12 w-auto object-contain drop-shadow" />
                      <span class="font-black text-xs text-slate-950 tracking-tight mt-0.5">
                        PALKIO<span class="text-amber-600">TECH</span>
                      </span>
                    </div>

                    <!-- Capsule Badge -->
                    <div class="inline-block px-3.5 py-1 rounded-full bg-slate-950 text-amber-400 font-mono font-bold text-[10px] border border-amber-400 shadow-xs">
                      ¡Solo toma unos segundos!
                    </div>

                  </div>

                  <!-- TRANSITION WAVE (CURVED WAVE WITH GOLD ACCENT LINE) -->
                  <div class="relative h-10 w-full overflow-hidden bg-white -mt-1">
                    <svg class="absolute bottom-0 w-full h-10 text-[#0c0d12]" viewBox="0 0 500 150" preserveAspectRatio="none">
                      <path d="M0.00,49.98 C150.00,150.00 349.20,-49.98 500.00,49.98 L500.00,150.00 L0.00,150.00 Z" style="stroke: none; fill: currentColor;"></path>
                    </svg>
                    <!-- Gold Accent Curve Line -->
                    <svg class="absolute bottom-0 w-full h-10" viewBox="0 0 500 150" preserveAspectRatio="none">
                      <path d="M0.00,49.98 C150.00,150.00 349.20,-49.98 500.00,49.98" style="stroke: #d4af37; stroke-width: 5; fill: none;"></path>
                    </svg>
                  </div>

                  <!-- BOTTOM SOLID BLACK SECTION -->
                  <div class="bg-[#0c0d12] text-white p-6 pt-2 pb-5 text-center relative">
                    
                    <div class="grid grid-cols-2 gap-4 items-center pt-2">
                      
                      <!-- Left: NFC Zone (TOCA AQUÍ) -->
                      <div class="flex flex-col items-center">
                        <div class="w-18 h-18 sm:w-20 sm:h-20 rounded-full border-2 border-amber-500/80 p-1 flex items-center justify-center shadow-[0_0_15px_rgba(245,158,11,0.3)]">
                          <div class="w-full h-full rounded-full border-2 border-white flex items-center justify-center bg-[#151620]">
                            <svg class="w-8 h-8 text-white animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8.111 16.404a5.5 5.5 0 010-7.778M12.354 19.167a9.5 9.5 0 000-13.434M16.596 22a13.5 13.5 0 000-19" />
                            </svg>
                          </div>
                        </div>
                        <span class="text-[11px] font-mono font-black text-white uppercase mt-2 block tracking-wider">
                          TOCA AQUÍ
                        </span>
                      </div>

                      <!-- Right: QR Zone (ESCANEA AQUÍ) -->
                      <div class="flex flex-col items-center">
                        <div class="relative w-18 h-18 sm:w-20 sm:h-20 flex items-center justify-center">
                          <!-- Gold Corner Brackets -->
                          <div class="absolute -top-1 -left-1 w-3.5 h-3.5 border-t-2 border-l-2 border-amber-400"></div>
                          <div class="absolute -top-1 -right-1 w-3.5 h-3.5 border-t-2 border-r-2 border-amber-400"></div>
                          <div class="absolute -bottom-1 -left-1 w-3.5 h-3.5 border-b-2 border-l-2 border-amber-400"></div>
                          <div class="absolute -bottom-1 -right-1 w-3.5 h-3.5 border-b-2 border-r-2 border-amber-400"></div>
                          
                          <!-- QR Graphic -->
                          <div class="w-full h-full bg-white rounded-lg p-1.5 shadow-md flex items-center justify-center">
                            <svg class="w-full h-full text-slate-950" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M2 2h8v8H2V2zm2 2v4h4V4H4zm10-2h8v8h-8V2zm2 2v4h4V4h-4zM2 14h8v8H2v-8zm2 2v4h4v-4H4zm14-2h2v2h-2v-2zm-4 0h2v4h-2v-4zm6 4h2v4h-2v-4zm-4 2h2v2h-2v-2zm4-6h2v2h-2v-2z"/>
                            </svg>
                          </div>
                        </div>
                        <span class="text-[11px] font-mono font-black text-white uppercase mt-2 block tracking-wider">
                          ESCANEA AQUÍ
                        </span>
                      </div>

                    </div>

                    <!-- Footer Yellow / Gold Notice -->
                    <div class="mt-4 pt-2.5 border-t border-white/10 text-center">
                      <span class="text-xs font-mono font-bold text-amber-400">
                        ¡Gracias por elegirnos!
                      </span>
                    </div>

                  </div>

                </div>

                <!-- Pedestal Stand Base Graphic -->
                <div class="w-48 h-3.5 mx-auto -mt-2 bg-gradient-to-r from-amber-500 via-amber-400 to-yellow-600 rounded-b-xl shadow-lg border-t border-yellow-200"></div>

                <div class="text-center pt-1">
                  <button 
                    type="button" 
                    id="btn-stand-tap-action"
                    class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-yellow-600 text-slate-950 font-black text-xs hover:scale-105 transition-transform cursor-pointer shadow-md"
                  >
                    <span>📲 Tocar Stand (Simular Interacción NFC)</span>
                  </button>
                </div>

              </div>

              <!-- STAGE 2: TARJETA PVC DOBLE CARA (FRENTE NFC & REVERSO QR) -->
              <div id="hw-stage-card" class="w-full space-y-4 hidden">
                
                <!-- Card Face Switcher Tabs -->
                <div class="flex items-center justify-between pb-2 border-b border-white/10">
                  <div class="flex items-center gap-1.5 p-1 rounded-xl bg-[#090a0e] border border-amber-400/40 text-[10px] font-mono">
                    <button 
                      type="button" 
                      id="btn-page-card-front" 
                      class="page-card-side-btn active px-3 py-1 rounded-lg bg-gradient-to-r from-amber-500 to-yellow-600 text-slate-950 font-black transition-all cursor-pointer shadow-xs"
                    >
                      <span>🪪 Frente: NFC</span>
                    </button>
                    <button 
                      type="button" 
                      id="btn-page-card-back" 
                      class="page-card-side-btn px-3 py-1 rounded-lg text-zinc-400 hover:text-white font-bold transition-all cursor-pointer"
                    >
                      <span>🔄 Reverso: QR</span>
                    </button>
                  </div>
                  <span class="text-[9px] font-mono font-bold text-amber-300 uppercase bg-amber-950/80 px-2 py-0.5 rounded border border-amber-800/60">
                    100% Personalizable
                  </span>
                </div>

                <!-- CARD FRONT -->
                <div id="page-card-face-front" class="relative w-full h-56 sm:h-64 rounded-3xl p-6 sm:p-8 flex flex-col justify-between border transition-all duration-500 overflow-hidden select-none bg-gradient-to-tr from-[#0a0a0c] via-[#16161c] to-[#0d0d10] border-amber-400/60 shadow-[0_20px_50px_rgba(0,0,0,0.95),0_0_35px_rgba(212,175,55,0.22)]">
                  <div class="absolute -inset-full bg-gradient-to-r from-transparent via-amber-400/15 to-transparent rotate-45 pointer-events-none transform translate-x-12"></div>

                  <div class="flex items-center justify-between relative z-10">
                    <div class="flex items-center gap-3">
                      <img src="/images/palkiotech-emblem.png" alt="PalkioTech" class="w-10 h-10 object-contain drop-shadow" />
                      <div>
                        <span class="font-black text-base tracking-tight text-white block leading-none">
                          PALKIO<span class="text-amber-400">TECH</span>
                        </span>
                        <span class="text-[8px] font-mono tracking-widest text-amber-300 font-bold uppercase mt-0.5 block">
                          SMART PVC CARD
                        </span>
                      </div>
                    </div>
                    <div class="flex items-center gap-1 text-amber-400/80">
                      <svg class="w-6 h-6 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8.111 16.404a5.5 5.5 0 010-7.778M12.354 19.167a9.5 9.5 0 000-13.434M16.596 22a13.5 13.5 0 000-19" />
                      </svg>
                    </div>
                  </div>

                  <div class="relative z-10 my-auto">
                    <div class="w-11 h-8 rounded-md bg-gradient-to-br from-amber-300 via-amber-500 to-yellow-600 border border-yellow-200/50 shadow-inner flex items-center justify-center opacity-90">
                      <div class="w-full h-px bg-yellow-900/40 my-auto"></div>
                    </div>
                  </div>

                  <div class="flex items-end justify-between relative z-10 pt-2 border-t border-white/10">
                    <div>
                      <span class="font-mono font-bold text-sm tracking-wider text-white uppercase block leading-none drop-shadow">
                        ALEJANDRO SALAS
                      </span>
                      <span class="font-mono text-[9px] text-amber-300/90 uppercase tracking-widest block mt-1">
                        FOUNDER & PRINCIPAL ENGINEER
                      </span>
                    </div>
                    <span class="text-[9px] font-mono text-zinc-400 bg-black/40 px-2 py-0.5 rounded border border-white/10">
                      FRENTE NFC
                    </span>
                  </div>
                </div>

                <!-- CARD BACK (QR DOBLE PROPÓSITO) -->
                <div id="page-card-face-back" class="relative w-full h-56 sm:h-64 rounded-3xl p-6 sm:p-7 flex flex-col justify-between border transition-all duration-500 overflow-hidden select-none bg-gradient-to-tr from-[#0d0e14] via-[#141620] to-[#0a0a0e] border-amber-400/60 shadow-[0_20px_50px_rgba(0,0,0,0.95),0_0_35px_rgba(212,175,55,0.22)] hidden text-center">
                  <div class="w-full h-6 bg-gradient-to-r from-zinc-950 via-zinc-900 to-zinc-950 rounded flex items-center px-3 border-y border-zinc-800">
                    <span class="text-[7px] font-mono text-zinc-500 tracking-widest uppercase">PALKIOTAG SMART PVC · CHIP NTAG216</span>
                  </div>

                  <div class="my-auto">
                    <span class="text-[10px] font-mono text-zinc-300 block mb-1.5">
                      Escanea con cualquier cámara de smartphone:
                    </span>
                    <div class="w-20 h-20 mx-auto rounded-xl bg-white p-1.5 shadow-xl flex items-center justify-center border-2 border-amber-400/70">
                      <svg class="w-full h-full text-slate-950" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M2 2h8v8H2V2zm2 2v4h4V4H4zm10-2h8v8h-8V2zm2 2v4h4V4h-4zM2 14h8v8H2v-8zm2 2v4h4v-4H4zm14-2h2v2h-2v-2zm-4 0h2v4h-2v-4zm6 4h2v4h-2v-4zm-4 2h2v2h-2v-2zm4-6h2v2h-2v-2z"/>
                      </svg>
                    </div>
                    <span class="text-[9px] font-mono text-emerald-400 font-bold block mt-1.5">
                      ✓ 100% Personalizable para lo que quieras
                    </span>
                  </div>

                  <div class="pt-2 border-t border-white/10 flex items-center justify-between text-[9px] font-mono text-zinc-400">
                    <span>Doble Propósito: NFC + QR</span>
                    <span class="text-amber-400 font-bold">REVERSO QR</span>
                  </div>
                </div>

              </div>

              <!-- STAGE 3: PLACA MENÚ QR MESA (RESTAURANTES) -->
              <div id="hw-stage-menu" class="w-full space-y-4 hidden">
                <div class="relative w-full max-w-[320px] mx-auto rounded-3xl p-6 bg-gradient-to-b from-[#12141c] to-[#0a0b10] border-2 border-emerald-500/60 shadow-xl text-center select-none">
                  <div class="flex items-center justify-between pb-2 border-b border-white/10 mb-3">
                    <span class="text-xs font-bold text-white">Café Bistró · Menú Digital</span>
                    <span class="text-[9px] font-mono text-emerald-400 bg-emerald-950/80 px-2 py-0.5 rounded border border-emerald-800">Mesa #4</span>
                  </div>
                  <div class="w-24 h-24 mx-auto rounded-2xl bg-white p-2 shadow-lg my-3 border border-emerald-400">
                    <svg class="w-full h-full text-slate-950" viewBox="0 0 24 24" fill="currentColor">
