---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { servicesData } from '../../data/services';
import { companyData } from '../../data/company';

const phone = companyData.whatsappNumber || '';
const baseWa = phone ? `https://api.whatsapp.com/send?phone=${phone}&text=` : `https://api.whatsapp.com/send?text=`;
---

<Layout 
  title="Catálogo Detallado de Soluciones & Arquitectura de Software | PalkioTech"
  description="Especificación técnica de ingeniería, alcances SOW, entregables y stack tecnológico para plataformas web, agentes de IA, mini-CRMs, apps móviles y tecnología NFC/QR."
>
  <Navbar />

  <main class="min-h-screen bg-[#f8fafc] text-slate-800">
    
    <!-- Hero Breadcrumb & Header -->
    <section class="pt-10 pb-16 bg-white border-b border-slate-200 relative overflow-hidden" data-navbar-theme="light">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-gradient-to-b from-amber-100/40 via-yellow-50/20 to-transparent blur-3xl pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs font-mono text-slate-500 mb-8">
          <a href="/" class="hover:text-amber-700 transition-colors">Inicio</a>
          <span>/</span>
          <span class="text-amber-700 font-bold">Catálogo de Soluciones & Alcances SOW</span>
        </nav>

        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 border border-amber-200 text-amber-900 text-xs font-mono font-bold mb-4 shadow-2xs">
            <span>✦ ESPECIFICACIÓN DETALLADA DE ENTREGABLES & ARQUITECTURA</span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
            Soluciones de Software & <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-600 via-yellow-600 to-amber-700">Hardware Phygital</span>
          </h1>

          <p class="text-slate-600 text-base sm:text-lg leading-relaxed max-w-3xl mx-auto mb-8">
            Cada paquete de ingeniería de PalkioTech incluye delimitación de alcance formal (SOW), criterios de aceptación cuantitativos, transferencia de código fuente y garantía SLA extendida.
          </p>

          <!-- Quick Navigation Anchor Pills -->
          <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-mono">
            {servicesData.map((svc) => (
              <a 
                href={`#${svc.id}`}
                class="px-3 py-1.5 rounded-xl bg-slate-50 hover:bg-amber-50 border border-slate-200 hover:border-amber-400 text-slate-700 hover:text-amber-900 transition-all font-semibold"
              >
                {svc.badge} ↓
              </a>
            ))}
          </div>

        </div>

      </div>
    </section>

    <!-- Detailed Services List -->
    <section class="py-16 sm:py-20" data-navbar-theme="light">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
        
        {servicesData.map((svc, idx) => (
          <div 
            id={svc.id}
            class="scroll-mt-24 rounded-3xl bg-white border border-slate-200 p-8 sm:p-12 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden"
          >
            {svc.featured && (
              <div class="absolute top-0 right-0 bg-gradient-to-r from-amber-500 to-yellow-600 text-slate-950 text-[10px] font-mono font-black uppercase px-5 py-1.5 rounded-bl-2xl tracking-wider">
                Solución Destacada
              </div>
            )}

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
              
              <!-- Left Column: Title, Subtitle & Context (~45%) -->
              <div class="lg:col-span-5 space-y-4">
                <div class="flex items-center gap-2.5">
                  <span class="w-8 h-8 rounded-lg bg-amber-100 text-amber-900 font-mono font-bold text-xs flex items-center justify-center border border-amber-300">
                    0{idx + 1}
                  </span>
                  <span class="text-xs font-mono font-bold uppercase tracking-wider text-amber-800 bg-amber-50 px-3 py-1 rounded-full border border-amber-200">
                    {svc.badge}
                  </span>
                  <span class="text-xs font-mono text-slate-500">
                    ⏱ {svc.timeline}
                  </span>
                </div>

                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-snug">
                  {svc.title}
                </h2>

                <p class="text-slate-600 text-sm leading-relaxed font-medium">
                  {svc.subtitle}
                </p>

                <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                  {svc.description}
                </p>

                <!-- Ideal For Box -->
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 text-xs">
                  <span class="font-mono font-bold text-amber-700 block mb-1">
                    🎯 Perfil de Negocio Recomendado:
                  </span>
                  <p class="text-slate-700 leading-relaxed">
                    {svc.idealFor}
                  </p>
                </div>

                <!-- Action CTAs for this service -->
                <div class="flex items-center gap-3 pt-2">
                  <a 
                    href="/cotizador"
                    class="py-2.5 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-yellow-600 hover:from-amber-600 hover:to-yellow-700 text-slate-950 font-black text-xs shadow-xs transition-all flex items-center gap-1.5"
                  >
                    <span>Cotizar en Línea</span>
                    <span>→</span>
                  </a>

                  {svc.id === 'nfc-qr-smart-solutions' ? (
                    <a 
                      href="/PalkioTag/"
                      class="py-2.5 px-4 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-900 font-bold text-xs border border-amber-300 transition-colors flex items-center gap-1"
                    >
                      <span>Simulador 3D NFC</span>
                      <span>↗</span>
                    </a>
                  ) : (
                    <a 
                      href="/#contacto"
                      class="py-2.5 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs border border-slate-300 transition-colors"
                    >
                      <span>Agendar Diagnóstico (20m)</span>
                    </a>
                  )}
                </div>

              </div>

              <!-- Right Column: Deliverables & Tech Stack (~55%) -->
              <div class="lg:col-span-7 flex flex-col justify-between border-t lg:border-t-0 lg:border-l border-slate-100 pt-6 lg:pt-0 lg:pl-8 space-y-6">
                
                <div>
                  <span class="text-xs font-mono uppercase tracking-wider text-slate-500 font-bold block mb-4">
                    ✦ Entregables Formales Incluidos en el Alcance (SOW):
                  </span>

                  <ul class="space-y-3">
                    {svc.deliverables.map((item) => (
                      <li class="flex items-start gap-3 p-3 rounded-xl bg-slate-50/70 border border-slate-100 text-xs text-slate-700 leading-relaxed">
                        <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Tech Stack Tags -->
                <div class="pt-4 border-t border-slate-100">
                  <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400 font-bold block mb-2">
                    Stack de Tecnologías & Herramientas:
                  </span>
                  <div class="flex flex-wrap gap-2">
                    {svc.techStack.map((tech) => (
                      <span class="text-xs font-mono text-slate-700 bg-slate-100 px-3 py-1 rounded-lg border border-slate-200">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>

              </div>

            </div>
          </div>
        ))}

      </div>
    </section>

    <!-- Bottom Callout -->
    <section class="py-16 bg-white border-t border-slate-200" data-navbar-theme="light">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h3 class="text-2xl font-extrabold text-slate-900 mb-3">
          ¿Necesitas una arquitectura a medida no listada aquí?
        </h3>
        <p class="text-sm text-slate-600 mb-6 leading-relaxed">
          Diseñamos sistemas y microservicios para industrias específicas con integraciones legacy y bases de datos relacionales complejas.
        </p>
        <div class="flex items-center justify-center gap-3">
          <a 
            href="/#contacto"
            class="py-3 px-6 rounded-xl bg-gradient-to-r from-amber-500 to-yellow-600 text-slate-950 font-black text-xs sm:text-sm shadow-md hover:scale-105 transition-all"
          >
            Hablar con Lead Software Architect →
          </a>
          <a 
            href="/blueprint"
            class="py-3 px-6 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs sm:text-sm border border-slate-300 transition-colors"
          >
            Ver Metodología & Blueprint
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
