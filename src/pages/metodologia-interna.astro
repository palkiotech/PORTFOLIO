<!-- Clean Client Script for QA Checklist -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var qaCheckboxes = document.querySelectorAll('.qa-checkbox');
    var qaCounter = document.getElementById('qa-counter');
    var resetQaBtn = document.getElementById('reset-qa-btn');

    function updateQaCounter() {
      var checkedCount = 0;
      qaCheckboxes.forEach(function(cb) {
        if (cb.checked) checkedCount++;
      });
      if (qaCounter) {
        qaCounter.textContent = checkedCount + ' / ' + qaCheckboxes.length + ' Verificados';
        if (checkedCount === qaCheckboxes.length) {
          qaCounter.classList.remove('bg-amber-50', 'text-amber-800', 'border-amber-200');
          qaCounter.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-200');
        } else {
          qaCounter.classList.add('bg-amber-50', 'text-amber-800', 'border-amber-200');
          qaCounter.classList.remove('bg-emerald-50', 'text-emerald-700', 'border-emerald-200');
        }
      }
    }

    qaCheckboxes.forEach(function(cb) {
      cb.addEventListener('change', updateQaCounter);
    });

    if (resetQaBtn) {
      resetQaBtn.addEventListener('click', function() {
        qaCheckboxes.forEach(function(cb) {
          cb.checked = false;
        });
        updateQaCounter();
      });
    }

    // Subnav sticky offset sync on scroll
    var subnav = document.getElementById('blueprint-subnav');
    window.addEventListener('scroll', function() {
      var scrollY = window.scrollY || window.pageYOffset;
      if (subnav) {
        if (scrollY > 30) {
          subnav.style.top = '52px';
        } else {
          subnav.style.top = '64px';
        }
      }
    }, { passive: true });
  });
</script>
