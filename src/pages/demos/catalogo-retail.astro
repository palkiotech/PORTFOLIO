              </span>
              {p.originalPrice && (
                <span class="text-xs text-slate-400 font-mono line-through">
                  ${p.originalPrice.toFixed(2)}
                </span>
              )}
            </div>

            <div class="flex items-center gap-1.5">
              <button 
                class="btn-open-quickview text-slate-600 hover:text-slate-900 p-2 rounded-xl border border-slate-200 hover:bg-slate-50 transition-colors"
