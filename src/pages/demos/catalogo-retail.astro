<!-- Client Side Business Logic for E-Commerce Engine with Payment Gateway and Course Enrollment -->
<script define:vars={{ catalogProducts, storeWorkshops }}>
  // State
  let cart = [];
  let currentStep = 1;
  let appliedDiscount = 0;
  let selectedModalProduct = null;
  let modalQty = 1;
  let selectedPaymentMethod = "card"; // "card" | "nequi" | "whatsapp"
  let isPaymentApproved = false;
  let generatedTxnId = "";
  let generatedAuthCode = "";
  let generatedOrderId = "";

  // DOM Elements
  const cartTrigger = document.getElementById('btn-cart-trigger');
  const drawer = document.getElementById('checkout-drawer');
  const drawerBackdrop = document.getElementById('checkout-drawer-backdrop');
  const btnCloseDrawer = document.getElementById('btn-close-drawer');
  const navBadge = document.getElementById('nav-cart-badge');

  const step1 = document.getElementById('drawer-step-1');
  const step2 = document.getElementById('drawer-step-2');
  const step3 = document.getElementById('drawer-step-3');
  const step4 = document.getElementById('drawer-step-4');
  const processingOverlay = document.getElementById('payment-processing-overlay');

  const badge1 = document.getElementById('step-badge-1');
  const badge2 = document.getElementById('step-badge-2');
  const badge3 = document.getElementById('step-badge-3');
  const badge4 = document.getElementById('step-badge-4');

  const btnStep1Next = document.getElementById('btn-drawer-step1-next');
  const btnStep2Next = document.getElementById('btn-drawer-step2-next');
  const btnProcessPayment = document.getElementById('btn-process-payment');
  const btnOrderWhatsAppDirect = document.getElementById('btn-order-whatsapp-direct');
  const btnNotifyPaidWhatsApp = document.getElementById('btn-notify-paid-whatsapp');
  const btnDrawerBack = document.getElementById('btn-drawer-back');

  const cartContainer = document.getElementById('cart-items-container');
  const subtotalEl = document.getElementById('summary-subtotal');
  const discountEl = document.getElementById('summary-discount');
  const rowDiscount = document.getElementById('row-discount');
  const totalEl = document.getElementById('summary-total');
  const gatewayTotalBadge = document.getElementById('gateway-total-badge');

  const couponInput = document.getElementById('coupon-input');
  const btnApplyCoupon = document.getElementById('btn-apply-coupon');
  const couponFeedback = document.getElementById('coupon-feedback');
  const floatingWa = document.getElementById('store-floating-wa');

  // Open/Close Drawer
  function openCheckout() {
    drawer?.classList.remove('translate-x-full');
    drawerBackdrop?.classList.remove('hidden');
    // Smoothly hide floating WhatsApp button so it never covers or obstructs checkout actions
    if (floatingWa) {
      floatingWa.classList.add('opacity-0', 'pointer-events-none', 'translate-y-8');
    }
    goToStep(1);
  }

  function closeCheckout() {
    drawer?.classList.add('translate-x-full');
    drawerBackdrop?.classList.add('hidden');
    // Smoothly restore floating WhatsApp button
    if (floatingWa) {
      floatingWa.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-8');
    }
  }

  cartTrigger?.addEventListener('click', openCheckout);
  btnCloseDrawer?.addEventListener('click', closeCheckout);
  drawerBackdrop?.addEventListener('click', closeCheckout);

  // Dynamic Toast Indicator (Appears when item is added, auto-dismisses smoothly)
  let toastTimer = null;
  function showToast(msg) {
    const toast = document.getElementById('store-toast');
    const toastText = document.getElementById('toast-text');
    if (!toast || !toastText) return;

    if (toastTimer) clearTimeout(toastTimer);

    toastText.textContent = msg;
    toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-6', 'scale-95');
    toast.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0', 'scale-100');

    toastTimer = setTimeout(() => {
      toast.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0', 'scale-100');
      toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-6', 'scale-95');
    }, 2800);
  }

  // Update Cart UI & Calculations
  function renderCart() {
    if (!cartContainer || !subtotalEl || !totalEl || !navBadge) return;

    let subtotal = 0;
    let count = 0;

    if (cart.length === 0) {
      cartContainer.innerHTML = '<div class="py-12 text-center text-slate-400 text-xs italic">Tu pedido está vacío. Agrega productos o talleres de la tienda.</div>';
      subtotalEl.textContent = '$0.00 USD';
      totalEl.textContent = '$0.00 USD';
      if (gatewayTotalBadge) gatewayTotalBadge.textContent = '$0.00 USD';
      navBadge.textContent = '0';
      if (rowDiscount) rowDiscount.classList.add('hidden');
      return;
    }

    cartContainer.innerHTML = '';
    cart.forEach(item => {
      subtotal += item.price * item.qty;
      count += item.qty;

      const row = document.createElement('div');
      row.className = "flex items-center gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs";
      row.innerHTML = `
        <img src="${item.img}" class="w-12 h-12 rounded-lg object-cover border border-slate-200 shrink-0" alt="${item.name}" />
        <div class="flex-1 min-w-0">
          <span class="font-bold text-slate-900 block truncate">${item.name}</span>
          <span class="font-mono text-slate-500">$${item.price.toFixed(2)} USD</span>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <button class="btn-qty-minus px-2 py-1 bg-white border border-slate-200 rounded text-slate-700 font-bold" data-id="${item.id}">-</button>
          <span class="font-mono font-bold px-1 text-slate-900">${item.qty}</span>
          <button class="btn-qty-plus px-2 py-1 bg-white border border-slate-200 rounded text-slate-700 font-bold" data-id="${item.id}">+</button>
          <button class="btn-qty-remove text-rose-500 hover:text-rose-700 ml-1 font-bold" data-id="${item.id}">✕</button>
        </div>
      `;
      cartContainer.appendChild(row);
    });

    const discountAmount = subtotal * appliedDiscount;
    const finalTotal = subtotal - discountAmount;

    subtotalEl.textContent = `$${subtotal.toFixed(2)} USD`;
    if (appliedDiscount > 0 && rowDiscount && discountEl) {
      rowDiscount.classList.remove('hidden');
      discountEl.textContent = `-$${discountAmount.toFixed(2)} USD`;
    } else if (rowDiscount) {
      rowDiscount.classList.add('hidden');
    }
    totalEl.textContent = `$${finalTotal.toFixed(2)} USD`;
    if (gatewayTotalBadge) gatewayTotalBadge.textContent = `$${finalTotal.toFixed(2)} USD`;
    navBadge.textContent = String(count);

    // Bind item buttons
    document.querySelectorAll('.btn-qty-plus').forEach(b => {
      b.addEventListener('click', (e) => {
        const id = e.currentTarget.getAttribute('data-id');
        const item = cart.find(i => i.id === id);
        if (item) item.qty++;
        renderCart();
      });
    });

    document.querySelectorAll('.btn-qty-minus').forEach(b => {
      b.addEventListener('click', (e) => {
        const id = e.currentTarget.getAttribute('data-id');
        const item = cart.find(i => i.id === id);
        if (item) {
          if (item.qty > 1) item.qty--;
          else cart = cart.filter(i => i.id !== id);
        }
        renderCart();
      });
    });

    document.querySelectorAll('.btn-qty-remove').forEach(b => {
      b.addEventListener('click', (e) => {
        const id = e.currentTarget.getAttribute('data-id');
        cart = cart.filter(i => i.id !== id);
        renderCart();
      });
    });
  }

  // Add Item to Cart
  function addToCart(item, qty = 1) {
    const existing = cart.find(i => i.id === item.id);
    if (existing) {
      existing.qty += qty;
    } else {
      cart.push({
        id: item.id,
        name: item.name || item.title,
        price: item.price,
        img: item.image || item.img,
        qty: qty
      });
    }
    renderCart();
    showToast(`✓ Agregado: ${item.name || item.title} (x${qty})`);
  }

  // Catalog item click
  document.querySelectorAll('.btn-catalog-add').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const id = e.currentTarget.getAttribute('data-id');
      const prod = catalogProducts.find(p => p.id === id);
      if (prod) addToCart(prod, 1);
    });
  });

  // Course item click (Enrolls course into cart!)
  document.querySelectorAll('.btn-enroll-course').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const id = e.currentTarget.getAttribute('data-id');
      const workshop = storeWorkshops.find(w => w.id === id);
      if (workshop) {
        addToCart({
          id: workshop.id,
          name: `[Taller] ${workshop.title}`,
          price: workshop.price,
          image: workshop.image
        }, 1);
        openCheckout();
      }
    });
  });

  // Coupon Logic
  btnApplyCoupon?.addEventListener('click', () => {
    const code = couponInput?.value.trim().toUpperCase();
    if (code === 'PALKIO10') {
      appliedDiscount = 0.10;
      if (couponFeedback) {
        couponFeedback.className = "text-[11px] font-mono mt-1 block text-emerald-700 font-bold";
        couponFeedback.textContent = "✓ ¡Cupón PALKIO10 aplicado! 10% de descuento.";
      }
      renderCart();
    } else {
      appliedDiscount = 0;
      if (couponFeedback) {
        couponFeedback.className = "text-[11px] font-mono mt-1 block text-rose-600 font-bold";
        couponFeedback.textContent = "Código inválido. Prueba con PALKIO10.";
      }
      renderCart();
    }
  });

  // Payment Method Tabs Logic
  const tabPayCard = document.getElementById('tab-pay-card');
  const tabPayNequi = document.getElementById('tab-pay-nequi');
  const tabPayWhatsapp = document.getElementById('tab-pay-whatsapp');

  const viewPayCard = document.getElementById('view-pay-card');
  const viewPayNequi = document.getElementById('view-pay-nequi');
  const viewPayWhatsapp = document.getElementById('view-pay-whatsapp');
  const btnPayLabel = document.getElementById('btn-pay-label');

  function setPaymentMethod(method) {
    selectedPaymentMethod = method;
    [tabPayCard, tabPayNequi, tabPayWhatsapp].forEach(t => {
      t?.classList.remove('active', 'border-blue-600', 'bg-blue-50/70', 'border-emerald-600', 'bg-emerald-50/70', 'border-purple-600', 'bg-purple-50/70');
      t?.classList.add('border-slate-200', 'bg-slate-50', 'text-slate-600');
    });

    [viewPayCard, viewPayNequi, viewPayWhatsapp].forEach(v => v?.classList.add('hidden'));

    if (method === 'card') {
      tabPayCard?.classList.add('active', 'border-blue-600', 'bg-blue-50/70', 'text-slate-900');
      viewPayCard?.classList.remove('hidden');
      btnProcessPayment?.classList.remove('hidden');
      btnOrderWhatsAppDirect?.classList.add('hidden');
      if (btnPayLabel && totalEl) btnPayLabel.textContent = `Pagar ${totalEl.textContent} con Tarjeta`;
    } else if (method === 'nequi') {
      tabPayNequi?.classList.add('active', 'border-purple-600', 'bg-purple-50/70', 'text-slate-900');
      viewPayNequi?.classList.remove('hidden');
      btnProcessPayment?.classList.remove('hidden');
      btnOrderWhatsAppDirect?.classList.add('hidden');
      if (btnPayLabel && totalEl) btnPayLabel.textContent = `Confirmar Pago Nequi ${totalEl.textContent}`;
    } else if (method === 'whatsapp') {
      tabPayWhatsapp?.classList.add('active', 'border-emerald-600', 'bg-emerald-50/70', 'text-slate-900');
      viewPayWhatsapp?.classList.remove('hidden');
      btnProcessPayment?.classList.add('hidden');
      btnOrderWhatsAppDirect?.classList.remove('hidden');
    }
  }

  tabPayCard?.addEventListener('click', () => setPaymentMethod('card'));
  tabPayNequi?.addEventListener('click', () => setPaymentMethod('nequi'));
  tabPayWhatsapp?.addEventListener('click', () => setPaymentMethod('whatsapp'));

  // Card Formatting Helper
  const cardNumberInput = document.getElementById('card-number');
  const cardExpiryInput = document.getElementById('card-expiry');
  const cardIcon = document.getElementById('card-type-icon');

  cardNumberInput?.addEventListener('input', (e) => {
    let val = e.target.value.replace(/\D/g, '');
    let formatted = '';
    for (let i = 0; i < val.length; i++) {
      if (i > 0 && i % 4 === 0) formatted += ' ';
      formatted += val[i];
    }
    e.target.value = formatted;

    if (val.startsWith('4')) {
      if (cardIcon) cardIcon.textContent = 'VISA';
    } else if (val.startsWith('5')) {
      if (cardIcon) cardIcon.textContent = 'MC';
    } else {
      if (cardIcon) cardIcon.textContent = '💳';
    }
  });

  cardExpiryInput?.addEventListener('input', (e) => {
    let val = e.target.value.replace(/\D/g, '');
    if (val.length >= 2) {
      val = val.substring(0, 2) + '/' + val.substring(2, 4);
    }
    e.target.value = val;
  });

  // Step Navigation in Drawer
  function goToStep(step) {
    currentStep = step;
    [step1, step2, step3, step4, processingOverlay].forEach(s => s?.classList.add('hidden'));

    if (step === 1) step1?.classList.remove('hidden');
    else if (step === 2) step2?.classList.remove('hidden');
    else if (step === 3) {
      step3?.classList.remove('hidden');
      setPaymentMethod(selectedPaymentMethod);
    } else if (step === 4) {
      step4?.classList.remove('hidden');
      populateSuccessReceipt();
    }

    [badge1, badge2, badge3, badge4].forEach((b, idx) => {
      if (idx + 1 === step) {
        b?.classList.remove('bg-slate-200', 'text-slate-600');
        b?.classList.add('bg-emerald-600', 'text-white');
      } else {
        b?.classList.remove('bg-emerald-600', 'text-white');
        b?.classList.add('bg-slate-200', 'text-slate-600');
      }
    });

    // Button states
    btnStep1Next?.classList.add('hidden');
    btnStep2Next?.classList.add('hidden');
    btnProcessPayment?.classList.add('hidden');
    btnOrderWhatsAppDirect?.classList.add('hidden');
    btnNotifyPaidWhatsApp?.classList.add('hidden');
    btnDrawerBack?.classList.add('hidden');

    if (step === 1) {
      btnStep1Next?.classList.remove('hidden');
    } else if (step === 2) {
      btnDrawerBack?.classList.remove('hidden');
      btnStep2Next?.classList.remove('hidden');
    } else if (step === 3) {
      btnDrawerBack?.classList.remove('hidden');
      if (selectedPaymentMethod === 'whatsapp') {
        btnOrderWhatsAppDirect?.classList.remove('hidden');
      } else {
        btnProcessPayment?.classList.remove('hidden');
      }
    } else if (step === 4) {
      btnNotifyPaidWhatsApp?.classList.remove('hidden');
    }
  }

  btnStep1Next?.addEventListener('click', () => {
    if (cart.length === 0) {
      alert("Agrega al menos un producto o taller a tu carrito.");
      return;
    }
    goToStep(2);
  });

  btnStep2Next?.addEventListener('click', () => {
    const name = document.getElementById('ship-name')?.value.trim();
    const phone = document.getElementById('ship-phone')?.value.trim();
    const addr = document.getElementById('ship-address')?.value.trim();

    if (!name || !phone || !addr) {
      alert("Por favor completa los campos obligatorios: Nombre, Teléfono y Dirección de entrega.");
      return;
    }
    goToStep(3);
  });

  btnDrawerBack?.addEventListener('click', () => {
    if (currentStep > 1 && currentStep < 4) goToStep(currentStep - 1);
  });

  // PROCESS SIMULATED ONLINE PAYMENT (Card / Nequi)
  btnProcessPayment?.addEventListener('click', () => {
    if (selectedPaymentMethod === 'card') {
      const cardNum = cardNumberInput?.value.replace(/\s/g, '');
      const cardExp = cardExpiryInput?.value.trim();
      const cardHolder = document.getElementById('card-holder')?.value.trim();

      if (!cardHolder || !cardNum || cardNum.length < 15 || !cardExp) {
        alert("Por favor ingresa los datos de la tarjeta válidos para la pasarela.");
        return;
      }
    }

    step3?.classList.add('hidden');
    btnProcessPayment?.classList.add('hidden');
    btnDrawerBack?.classList.add('hidden');
    processingOverlay?.classList.remove('hidden');

    setTimeout(() => {
      isPaymentApproved = true;
      generatedOrderId = `#ORD-${Math.floor(1000 + Math.random() * 9000)}`;
      generatedTxnId = `TXN-${Math.floor(10000000 + Math.random() * 90000000)}`;
      generatedAuthCode = `#AUTH-${Math.floor(100000 + Math.random() * 900000)}`;

      processingOverlay?.classList.add('hidden');
      goToStep(4);
    }, 1800);
  });

  // Populates Receipt in Step 4
  function populateSuccessReceipt() {
    const name = document.getElementById('ship-name')?.value.trim() || 'Cliente';
    const phone = document.getElementById('ship-phone')?.value.trim() || 'No especificado';
    const city = document.getElementById('ship-city')?.value.trim() || 'Bogotá';
    const addr = document.getElementById('ship-address')?.value.trim() || '';

    const recOrderId = document.getElementById('receipt-order-id');
    const recTxnId = document.getElementById('receipt-txn-id');
    const recAuth = document.getElementById('receipt-auth-code');
    const recName = document.getElementById('receipt-name');
    const recPhone = document.getElementById('receipt-phone');
    const recAddr = document.getElementById('receipt-address');
    const recMethod = document.getElementById('receipt-payment-method');
    const recTotal = document.getElementById('receipt-total');
    const recBadge = document.getElementById('receipt-txn-badge');
    const title = document.getElementById('success-title');

    if (recOrderId) recOrderId.textContent = generatedOrderId || `#ORD-${Math.floor(1000 + Math.random() * 9000)}`;
    if (recTxnId) recTxnId.textContent = generatedTxnId || `TXN-${Math.floor(10000000 + Math.random() * 90000000)}`;
    if (recAuth) recAuth.textContent = generatedAuthCode || `#AUTH-${Math.floor(100000 + Math.random() * 900000)}`;
    if (recName) recName.textContent = name;
    if (recPhone) recPhone.textContent = phone;
    if (recAddr) recAddr.textContent = `${addr}, ${city}`;
    if (recTotal && totalEl) recTotal.textContent = totalEl.textContent;

    if (selectedPaymentMethod === 'card') {
      if (recMethod) recMethod.textContent = 'Tarjeta de Crédito / Débito (Pasarela SSL)';
      if (recBadge) recBadge.textContent = '100% Pagado & Aprobado';
      if (title) title.textContent = '¡Pago Aprobado con Éxito!';
    } else if (selectedPaymentMethod === 'nequi') {
      if (recMethod) recMethod.textContent = 'Transferencia Nequi / Bancolombia';
      if (recBadge) recBadge.textContent = '100% Pagado & Aprobado';
      if (title) title.textContent = '¡Transferencia Registrada con Éxito!';
    } else {
      if (recMethod) recMethod.textContent = 'Pago Contra Entrega en Domicilio';
      if (recBadge) {
        recBadge.textContent = 'Pendiente de Pago en Entrega';
        recBadge.className = 'bg-amber-100 text-amber-800 text-[10px] px-2 py-0.5 rounded font-bold';
      }
      if (title) title.textContent = '¡Orden Generada Exitosamente!';
    }
  }

  // DISPATCH WHATSAPP DIRECT (For Contra Entrega)
  btnOrderWhatsAppDirect?.addEventListener('click', () => {
    const orderId = `#ORD-${Math.floor(1000 + Math.random() * 9000)}`;
    const name = document.getElementById('ship-name')?.value.trim() || 'Cliente';
    const phone = document.getElementById('ship-phone')?.value.trim() || '';
    const city = document.getElementById('ship-city')?.value.trim() || 'Bogotá';
    const addr = document.getElementById('ship-address')?.value.trim() || '';
    const notes = document.getElementById('ship-notes')?.value.trim() || 'Ninguna';

    let msg = `🌿 *NUEVO PEDIDO ${orderId} — ESTUDIO BOTÁNICO*\n`;
    msg += `------------------------------------\n`;
    msg += `👤 *Cliente:* ${name}\n`;
    msg += `📱 *WhatsApp:* ${phone}\n`;
    msg += `📍 *Dirección / Sede:* ${addr}, ${city}\n`;
    msg += `📝 *Notas:* ${notes}\n\n`;
    msg += `📦 *PRODUCTOS / TALLERES:* \n`;

    let subtotal = 0;
    cart.forEach(item => {
      msg += `• ${item.qty}x ${item.name} — $${(item.price * item.qty).toFixed(2)} USD\n`;
      subtotal += item.price * item.qty;
    });

    const discountAmount = subtotal * appliedDiscount;
    const total = subtotal - discountAmount;

    msg += `\n💵 *RESUMEN DE PAGO:*\n`;
    msg += `Subtotal: $${subtotal.toFixed(2)} USD\n`;
    if (appliedDiscount > 0) {
      msg += `Descuento (PALKIO10): -$${discountAmount.toFixed(2)} USD\n`;
    }
    msg += `Envío: GRATIS\n`;
    msg += `*TOTAL A PAGAR: $${total.toFixed(2)} USD*\n`;
    msg += `*Método de Pago:* Pago Contra Entrega en Domicilio\n`;
    msg += `------------------------------------\n`;
    msg += `¿Podrían confirmarme la recepción del pedido y hora de entrega?`;

    const url = `https://api.whatsapp.com/send?text=${encodeURIComponent(msg)}`;
    window.open(url, '_blank');
  });

  // NOTIFY PAID ORDER TO WHATSAPP (Post Gateway Approval)
  btnNotifyPaidWhatsApp?.addEventListener('click', () => {
    const orderId = document.getElementById('receipt-order-id')?.textContent || '#ORD-PAGADO';
    const txnId = document.getElementById('receipt-txn-id')?.textContent || 'TXN-000';
    const authCode = document.getElementById('receipt-auth-code')?.textContent || '#AUTH-000';
    const name = document.getElementById('ship-name')?.value.trim() || 'Cliente';
    const phone = document.getElementById('ship-phone')?.value.trim() || '';
    const city = document.getElementById('ship-city')?.value.trim() || 'Bogotá';
    const addr = document.getElementById('ship-address')?.value.trim() || '';
    const method = document.getElementById('receipt-payment-method')?.textContent || 'Pasarela';
    const total = document.getElementById('receipt-total')?.textContent || '$0.00 USD';

    let msg = `✅ *COMPROBANTE DE ORDEN PAGADA ${orderId} — ESTUDIO BOTÁNICO*\n`;
    msg += `------------------------------------\n`;
    msg += `💳 *Estado de Pago:* APROBADO (100% Pagado)\n`;
    msg += `🧾 *Transacción:* ${txnId} · ${authCode}\n`;
    msg += `👤 *Cliente:* ${name}\n`;
    msg += `📱 *WhatsApp:* ${phone}\n`;
    msg += `📍 *Dirección de Entrega / Acceso:* ${addr}, ${city}\n\n`;
    msg += `📦 *PRODUCTOS / INSCRIPCIONES:* \n`;

    cart.forEach(item => {
      msg += `• ${item.qty}x ${item.name} — $${(item.price * item.qty).toFixed(2)} USD\n`;
    });

    msg += `\n💵 *TOTAL PAGADO: ${total}*\n`;
    msg += `*Método:* ${method}\n`;
    msg += `------------------------------------\n`;
    msg += `Acabo de completar el pago en línea. Por favor confírmenme el despacho o enlace del taller.`;

    const url = `https://api.whatsapp.com/send?text=${encodeURIComponent(msg)}`;
    window.open(url, '_blank');
  });

  // Quick View Modal Logic
  const modal = document.getElementById('product-modal');
  const modalBackdrop = document.getElementById('product-modal-backdrop');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const modalImg = document.getElementById('modal-img');
  const modalCat = document.getElementById('modal-cat');
  const modalTitle = document.getElementById('modal-title');
  const modalRating = document.getElementById('modal-rating');
  const modalSku = document.getElementById('modal-sku');
  const modalPrice = document.getElementById('modal-price');
  const modalDesc = document.getElementById('modal-desc');
  const modalSpecs = document.getElementById('modal-specs-container');
  const modalQtyVal = document.getElementById('modal-qty-val');
  const modalBtnAdd = document.getElementById('modal-btn-add');

  function openQuickview(prodId) {
    const prod = catalogProducts.find(p => p.id === prodId);
    if (!prod) return;
    selectedModalProduct = prod;
    modalQty = 1;
    if (modalQtyVal) modalQtyVal.textContent = '1';

    if (modalImg) modalImg.src = prod.image;
    if (modalCat) modalCat.textContent = prod.category;
    if (modalTitle) modalTitle.textContent = prod.name;
    if (modalRating) modalRating.textContent = `★ ${prod.rating} (${prod.reviews} reseñas)`;
    if (modalSku) modalSku.textContent = `SKU: ${prod.sku}`;
    if (modalPrice) modalPrice.textContent = `$${prod.price.toFixed(2)} `;
    if (modalDesc) modalDesc.textContent = prod.shortDesc;

    if (modalSpecs) {
      modalSpecs.innerHTML = '';
      for (const [k, v] of Object.entries(prod.specs)) {
        const item = document.createElement('div');
        item.className = "flex justify-between py-1 border-b border-slate-200/60 last:border-0";
        item.innerHTML = `<span class="text-slate-500 capitalize">${k}:</span> <strong class="text-slate-900">${v}</strong>`;
        modalSpecs.appendChild(item);
      }
    }

    modal?.classList.remove('hidden');
    modalBackdrop?.classList.remove('hidden');
  }

  function closeModal() {
    modal?.classList.add('hidden');
    modalBackdrop?.classList.add('hidden');
  }

  document.querySelectorAll('.btn-open-quickview').forEach(b => {
    b.addEventListener('click', (e) => {
      const id = e.currentTarget.getAttribute('data-id');
      if (id) openQuickview(id);
    });
  });

  btnCloseModal?.addEventListener('click', closeModal);
  modalBackdrop?.addEventListener('click', closeModal);

  document.getElementById('modal-qty-plus')?.addEventListener('click', () => {
    modalQty++;
    if (modalQtyVal) modalQtyVal.textContent = String(modalQty);
  });

  document.getElementById('modal-qty-minus')?.addEventListener('click', () => {
    if (modalQty > 1) {
      modalQty--;
      if (modalQtyVal) modalQtyVal.textContent = String(modalQty);
    }
  });

  modalBtnAdd?.addEventListener('click', () => {
    if (selectedModalProduct) {
      addToCart(selectedModalProduct, modalQty);
      closeModal();
    }
  });

  // Live Instant Search Filter
  const liveSearch = document.getElementById('live-search-input');
  const catalogGrid = document.getElementById('products-catalog-grid');
  const catalogItems = document.querySelectorAll('.catalog-item');

  liveSearch?.addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase().trim();
    catalogItems.forEach(card => {
      const name = card.getAttribute('data-name') || '';
      const cat = (card.getAttribute('data-category') || '').toLowerCase();
      if (name.includes(q) || cat.includes(q)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  });

  // Category Tabs Filter
  const catPills = document.querySelectorAll('#store-cat-filters .cat-pill');
  catPills.forEach(pill => {
    pill.addEventListener('click', () => {
      catPills.forEach(p => {
        p.classList.remove('bg-slate-900', 'text-white');
        p.classList.add('bg-slate-100', 'text-slate-600');
      });
      pill.classList.add('bg-slate-900', 'text-white');
      pill.classList.remove('bg-slate-100', 'text-slate-600');

      const selected = pill.getAttribute('data-cat');
      catalogItems.forEach(card => {
        const cat = card.getAttribute('data-category');
        if (selected === 'all' || cat === selected) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Sorting Dropdown
  const sortSelect = document.getElementById('sort-select');
  sortSelect?.addEventListener('change', (e) => {
    const val = e.target.value;
    const cardsArr = Array.from(catalogItems);

    if (val === 'price-asc') {
      cardsArr.sort((a, b) => parseFloat(a.dataset.price) - parseFloat(b.dataset.price));
    } else if (val === 'price-desc') {
      cardsArr.sort((a, b) => parseFloat(b.dataset.price) - parseFloat(a.dataset.price));
    } else if (val === 'rating') {
      cardsArr.sort((a, b) => parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating));
    }

    if (catalogGrid) {
      cardsArr.forEach(c => catalogGrid.appendChild(c));
    }
  });

  // Initial render
  renderCart();
</script>
