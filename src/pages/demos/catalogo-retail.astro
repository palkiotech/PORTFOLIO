                <span class="text-amber-500 font-bold font-mono">★ {p.rating}</span>
                <span class="text-slate-400 font-mono">({p.reviews} reseñas)</span>
              </div>

              <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed mb-3">
                {p.shortDesc}
              </p>
            </div>
          </div>

          <!-- Bottom Card Bar -->
          <div class="p-5 pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
            <div>
              <span class="text-lg font-extrabold text-slate-900 font-mono block leading-none">
