---

<Layout 
  title="Estudio Botánico Pro | E-Commerce, Talleres & WhatsApp Checkout | PalkioTech"
  description="Plataforma e-commerce completa con catálogo de plantas, venta de cursos y talleres, pasarela de pago en línea, testimonios y checkout directo a WhatsApp."
>
  <!-- Top Demo Disclaimer Header -->
  <div class="bg-slate-900 text-white text-xs py-2.5 px-4 font-mono sticky top-0 z-50 shadow-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <img src="/images/palkiotech-emblem.png" alt="PalkioTech" class="w-4 h-4 object-contain" />
        <span class="font-bold text-white">PALKIOTECH E-COMMERCE & ACADEMY ENGINE:</span>
        <span class="text-slate-300 hidden md:inline">Tienda Web Completa, Cursos & Pasarela SSL con WhatsApp Sync</span>
      </div>
      <div class="flex items-center gap-3">
        <a href="/#demos" class="text-amber-400 hover:text-white underline transition-colors">
          ← Volver al Portafolio
        </a>
        <a href="/#contacto" class="bg-gradient-to-r from-amber-500 via-amber-600 to-yellow-600 hover:from-amber-600 hover:to-yellow-700 text-slate-950 font-black px-3.5 py-1.5 rounded text-[11px] transition-all">
          Cotizar Este Sistema
        </a>
      </div>
    </div>
  </div>

  <!-- Store Brand Navigation Header -->
  <header class="bg-white border-b border-slate-200 sticky top-10 z-40 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
      
      <!-- Brand Logo -->
      <a href="/demos/catalogo-retail" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-emerald-700 text-white flex items-center justify-center font-bold text-lg shadow-sm group-hover:scale-105 transition-transform">
          🌿
        </div>
        <div>
          <span class="font-extrabold text-lg tracking-tight text-slate-900 block leading-tight">
            ESTUDIO BOTÁNICO
          </span>
          <span class="text-xs text-slate-500 font-medium">
            Selección Botánica & Academia Viva
          </span>
        </div>
      </a>

      <!-- Navigation Links -->
      <nav class="hidden lg:flex items-center gap-6 text-xs font-semibold text-slate-600">
        <a href="#catalogo" class="hover:text-emerald-700 transition-colors">Catálogo de Plantas</a>
        <a href="#cursos" class="hover:text-emerald-700 transition-colors flex items-center gap-1.5">
          <span>Talleres & Cursos</span>
          <span class="bg-emerald-100 text-emerald-800 text-[10px] px-1.5 py-0.2 rounded font-mono font-bold">Nuevo</span>
        </a>
        <a href="#testimonios" class="hover:text-emerald-700 transition-colors">Opiniones</a>
        <a href="#contacto-tienda" class="hover:text-emerald-700 transition-colors">Sede & Contacto</a>
      </nav>

      <!-- Search Bar -->
      <div class="relative flex-1 max-w-xs hidden xl:block">
        <input 
          id="live-search-input"
          type="text" 
          placeholder="Buscar plantas o cursos (<10ms)..." 
          class="w-full bg-slate-50 border border-slate-300 rounded-xl pl-9 pr-3 py-2 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-emerald-600 focus:bg-white transition-all font-mono"
        />
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>

      <!-- Header CTAs -->
      <div class="flex items-center gap-3">
        <!-- Coupon Pill -->
        <div class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-mono">
          <span class="font-bold">Cupón 10%:</span>
          <span class="bg-white px-1.5 py-0.5 rounded border border-emerald-300 font-bold select-all">PALKIO10</span>
        </div>

        <!-- Cart Trigger Button -->
        <button 
          id="btn-cart-trigger"
          class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-emerald-700 text-white text-xs font-bold transition-all relative shadow-sm"
        >
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
          <span class="hidden sm:inline">Mi Pedido</span>
          <span id="nav-cart-badge" class="w-5 h-5 rounded-full bg-emerald-500 text-slate-950 font-mono text-[10px] font-extrabold flex items-center justify-center">0</span>
        </button>
      </div>

    </div>
  </header>

  <!-- Store Hero Banner -->
  <section class="bg-gradient-to-r from-emerald-900 via-teal-950 to-slate-900 text-white py-14 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-8 items-center relative z-10">
      
      <div class="md:col-span-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-mono font-bold mb-4 border border-emerald-500/30">
          <span>✦ TIENDA BOTÁNICA, ACADEMIA & PASARELA DE PAGO SSL</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight mb-4">
          Naturaleza viva, diseño y educación botánica para tu hogar.
        </h1>
        <p class="text-sm sm:text-base text-emerald-100/90 leading-relaxed max-w-2xl mb-6">
          Compra especies botánicas de colección o inscríbete a nuestras masterclasses virtuales y presenciales. Paga en línea de inmediato o contra entrega con despacho a WhatsApp.
        </p>
        <div class="flex flex-wrap items-center gap-6 text-xs text-emerald-200 font-mono">
          <span class="flex items-center gap-1.5">💳 Pasarela SSL Cifrada (Tarjetas / Nequi / PSE)</span>
          <span class="flex items-center gap-1.5">🎓 Masterclasses con Certificado</span>
          <span class="flex items-center gap-1.5">💬 Despacho instantáneo a WhatsApp</span>
        </div>
      </div>

      <div class="md:col-span-4 flex flex-col gap-3">
        <div class="p-5 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 text-center">
          <span class="text-[11px] font-mono uppercase tracking-wider text-emerald-300 block mb-1">Tecnología de la Tienda</span>
          <span class="text-3xl font-extrabold font-mono text-white block mb-0.5">< 25 ms</span>
          <p class="text-xs text-emerald-100">Carga reactiva instantánea y checkout en 4 pasos.</p>
        </div>
        <div class="p-3 rounded-xl bg-emerald-950/60 border border-emerald-800/40 text-center text-xs text-emerald-200 font-mono">
          📦 Envío gratis en órdenes superiores a $50 USD
        </div>
      </div>

    </div>
  </section>

  <!-- Filter Bar: Categories & Sorting -->
  <div id="catalogo" class="bg-white border-b border-slate-200 sticky top-30 z-30 shadow-2xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      
      <!-- Category Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0 scrollbar-none" id="store-cat-filters">
        <button class="cat-pill active text-xs font-bold px-3.5 py-1.5 rounded-lg bg-slate-900 text-white transition-all shrink-0" data-cat="all">
          Todos los Productos ({catalogProducts.length})
        </button>
        <button class="cat-pill text-xs font-bold px-3.5 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all shrink-0" data-cat="Plantas de Interior">
          Plantas de Interior
        </button>
        <button class="cat-pill text-xs font-bold px-3.5 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all shrink-0" data-cat="Macetas de Diseño">
          Macetas
        </button>
        <button class="cat-pill text-xs font-bold px-3.5 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all shrink-0" data-cat="Accesorios Botánicos">
          Accesorios
        </button>
        <button class="cat-pill text-xs font-bold px-3.5 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all shrink-0" data-cat="Sustratos & Abonos">
          Sustratos & Abonos
        </button>
      </div>

      <!-- Sorting Select -->
      <div class="flex items-center gap-2 shrink-0">
        <span class="text-xs text-slate-500 font-medium">Ordenar:</span>
        <select id="sort-select" class="bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-800 rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-emerald-600">
          <option value="default">Recomendados</option>
          <option value="price-asc">Precio: Menor a Mayor</option>
          <option value="price-desc">Precio: Mayor a Menor</option>
          <option value="rating">Mejor Calificados (★)</option>
        </select>
      </div>

    </div>
  </div>

  <!-- Main Product Grid Section -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="products-catalog-grid">
      {catalogProducts.map((p) => (
        <div 
          class="catalog-item bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-md hover:border-slate-300 transition-all flex flex-col justify-between group"
          data-id={p.id}
          data-category={p.category}
