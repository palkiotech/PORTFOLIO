  <!-- Client-side Interactive Medical Engine (Vite Bundled Script) -->
  <script define:vars={{ doctorsList }}>
    // Set default tomorrow date on date input
    const dateInput = document.getElementById('book-date');
    if (dateInput) {
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      dateInput.value = tomorrow.toISOString().slice(0, 10);
    }

    // Dynamic Time Slots Generator based on selected doctor
    const docSelect = document.getElementById('book-doctor');
    const slotsContainer = document.getElementById('time-slots-container');
    const selectedSlotInput = document.getElementById('selected-slot');

    function renderTimeSlots(doctorId) {
      if (!slotsContainer) return;
      slotsContainer.innerHTML = '';

      const doc = doctorsList.find(d => d.id === doctorId) || doctorsList[0];
      const slots = doc.slots || ["08:30 AM", "09:15 AM", "11:00 AM", "02:30 PM", "04:15 PM"];

      if (selectedSlotInput) selectedSlotInput.value = slots[0];

      slots.forEach((slot, index) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = index === 0
          ? "time-slot-btn py-2 px-1 text-center font-mono font-bold text-xs rounded-xl bg-blue-600 text-white shadow-xs border border-blue-600 transition-all"
          : "time-slot-btn py-2 px-1 text-center font-mono font-bold text-xs rounded-xl bg-slate-50 text-slate-700 hover:bg-slate-100 border border-slate-200 transition-all";
        btn.textContent = slot;

        btn.addEventListener('click', () => {
          document.querySelectorAll('.time-slot-btn').forEach(b => {
            b.className = "time-slot-btn py-2 px-1 text-center font-mono font-bold text-xs rounded-xl bg-slate-50 text-slate-700 hover:bg-slate-100 border border-slate-200 transition-all";
          });
          btn.className = "time-slot-btn py-2 px-1 text-center font-mono font-bold text-xs rounded-xl bg-blue-600 text-white shadow-xs border border-blue-600 transition-all";
          if (selectedSlotInput) selectedSlotInput.value = slot;
        });

        slotsContainer.appendChild(btn);
      });
    }

    docSelect?.addEventListener('change', (e) => {
      renderTimeSlots(e.target.value);
    });
    renderTimeSlots(doctorsList[0].id);

    // Doctor card click "Agendar con este médico"
    document.querySelectorAll('.btn-select-doctor').forEach(btn => {
      btn.addEventListener('click', () => {
        const docId = btn.getAttribute('data-id');
        if (docSelect && docId) {
          docSelect.value = docId;
          renderTimeSlots(docId);
          document.getElementById('agendamiento')?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // Step 1 to Step 2 Navigation
    const step1El = document.getElementById('booking-step-1');
    const step2El = document.getElementById('booking-step-2');
    const stepNum = document.getElementById('booking-step-num');
    const btnGotoStep2 = document.getElementById('btn-goto-step-2');
    const btnBackStep1 = document.getElementById('btn-back-step-1');

    const summaryDocSpec = document.getElementById('summary-doc-spec');
    const summaryDocFee = document.getElementById('summary-doc-fee');
    const summaryDateTime = document.getElementById('summary-date-time');
    const summarySede = document.getElementById('summary-sede');

    btnGotoStep2?.addEventListener('click', () => {
      const selectedDocId = docSelect?.value;
      const doc = doctorsList.find(d => d.id === selectedDocId) || doctorsList[0];
      const slot = selectedSlotInput?.value || '08:30 AM';
      const dateVal = dateInput?.value || 'Mañana';
      const sedeVal = document.getElementById('book-sede')?.value.split('·')[0].trim() || 'Sede Chicó';

      if (summaryDocSpec) summaryDocSpec.textContent = `${doc.name} (${doc.specialty})`;
      if (summaryDocFee) summaryDocFee.textContent = doc.fee;
      if (summaryDateTime) summaryDateTime.textContent = `Fecha: ${dateVal} · ${slot}`;
      if (summarySede) summarySede.textContent = sedeVal;

      step1El?.classList.add('hidden');
      step2El?.classList.remove('hidden');
      if (stepNum) stepNum.textContent = '2';
    });

    btnBackStep1?.addEventListener('click', () => {
      step2El?.classList.add('hidden');
      step1El?.classList.remove('hidden');
      if (stepNum) stepNum.textContent = '1';
    });

    // Modal Ticket Pass Elements
    const bookingForm = document.getElementById('clinic-booking-form');
    const modalTicket = document.getElementById('modal-ticket-pass');
    const btnCloseTicket = document.getElementById('btn-close-ticket');
    const btnPrintTicket = document.getElementById('btn-print-ticket');
    const btnTicketWhatsApp = document.getElementById('btn-ticket-whatsapp');

    const ticketFolio = document.getElementById('ticket-folio');
    const ticketDocName = document.getElementById('ticket-doctor-name');
    const ticketDocSpec = document.getElementById('ticket-doctor-spec');
    const ticketFee = document.getElementById('ticket-fee');
    const ticketDateTime = document.getElementById('ticket-datetime');
    const ticketSede = document.getElementById('ticket-sede');
    const ticketPatientName = document.getElementById('ticket-patient-name');
    const ticketPatientDoc = document.getElementById('ticket-patient-doc');
    const ticketInsurance = document.getElementById('ticket-insurance');
    const ticketPrep = document.getElementById('ticket-prep-instructions');

    let lastBookingDetails = null;

    bookingForm?.addEventListener('submit', (e) => {
      e.preventDefault();

      const selectedDocId = docSelect?.value;
      const doc = doctorsList.find(d => d.id === selectedDocId) || doctorsList[0];
      const slot = selectedSlotInput?.value || '08:30 AM';
      const dateVal = dateInput?.value || 'Mañana';
      const sedeVal = document.getElementById('book-sede')?.value || 'Sede Chicó Norte';
      const patientName = document.getElementById('patient-name')?.value.trim() || 'Paciente';
      const patientDoc = document.getElementById('patient-doc')?.value.trim() || 'No especificado';
      const patientPhone = document.getElementById('patient-phone')?.value.trim() || '';
      const insurance = document.getElementById('patient-insurance')?.value || 'Particular';
      const motive = document.getElementById('patient-motive')?.value.trim() || 'Consulta médica general';

      const generatedFolio = `#MED-2026-${Math.floor(1000 + Math.random() * 9000)}`;

      lastBookingDetails = {
        folio: generatedFolio,
        docName: doc.name,
        docSpec: doc.specialty,
        fee: doc.fee,
        office: doc.office,
        date: dateVal,
        slot: slot,
        sede: sedeVal,
        patientName: patientName,
        patientDoc: patientDoc,
        phone: patientPhone,
        insurance: insurance,
        motive: motive,
        prep: doc.prepInstructions
      };

      // Populate Ticket
      if (ticketFolio) ticketFolio.textContent = `Folio: ${generatedFolio}`;
      if (ticketDocName) ticketDocName.textContent = doc.name;
      if (ticketDocSpec) ticketDocSpec.textContent = doc.specialty;
      if (ticketFee) ticketFee.textContent = doc.fee;
      if (ticketDateTime) ticketDateTime.textContent = `${dateVal} · ${slot}`;
      if (ticketSede) ticketSede.textContent = `${sedeVal} · ${doc.office}`;
      if (ticketPatientName) ticketPatientName.textContent = patientName;
      if (ticketPatientDoc) ticketPatientDoc.textContent = patientDoc;
      if (ticketInsurance) ticketInsurance.textContent = insurance;
      if (ticketPrep) ticketPrep.textContent = doc.prepInstructions;

      modalTicket?.classList.remove('hidden');
    });

    btnCloseTicket?.addEventListener('click', () => {
      modalTicket?.classList.add('hidden');
    });

    btnPrintTicket?.addEventListener('click', () => {
      window.print();
    });

    btnTicketWhatsApp?.addEventListener('click', () => {
      if (!lastBookingDetails) return;
      const b = lastBookingDetails;

      let msg = `🏥 *CONFIRMACIÓN DE CITA MÉDICA ${b.folio} — CLÍNICA SALUD TOTAL*\n`;
      msg += `------------------------------------\n`;
      msg += `👤 *Paciente:* ${b.patientName} (Doc: ${b.patientDoc})\n`;
      msg += `📱 *WhatsApp:* ${b.phone}\n`;
      msg += `👨‍⚕️ *Especialista:* ${b.docName} (${b.docSpec})\n`;
      msg += `📅 *Fecha & Hora:* ${b.date} a las ${b.slot}\n`;
      msg += `📍 *Lugar:* ${b.sede} — ${b.office}\n`;
      msg += `💼 *Cobertura:* ${b.insurance}\n`;
      msg += `💵 *Valor Consulta:* ${b.fee}\n`;
      msg += `------------------------------------\n`;
      msg += `⚠️ *Instrucciones:* ${b.prep}\n\n`;
      msg += `Acabo de agendar mi cita en el portal web. Por favor confirmarme la recepción en el sistema.`;

      const url = `https://api.whatsapp.com/send?text=${encodeURIComponent(msg)}`;
      window.open(url, '_blank');
    });

    // Laboratory Search Simulator
    const labForm = document.getElementById('lab-search-form');
    const labResultBox = document.getElementById('lab-result-box');
    const btnDownloadLab = document.getElementById('btn-download-lab-pdf');

    labForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      labResultBox?.classList.remove('hidden');
    });

    btnDownloadLab?.addEventListener('click', () => {
      alert("[REPORTE CLÍNICO DESCARGADO]\n\nExamen: Perfil Lipídico Completo & Glucosa\nPaciente: Carolina Morales (Doc: 1020849201)\nOrden: #LAB-9842\nEstado: Valores dentro de rangos normales de referencia.\nFirma Digital: Dra. Elena Restrepo (Bacterióloga Reg. 3910)\n\nEl archivo PDF oficial ha sido generado y descargado con validez clínica.");
    });
  </script>
</Layout>
