---

<Layout 
  title="Clínica Salud Total | Centro Médico de Especialistas & Agendamiento IA"
  description="Plataforma médica de alto rendimiento: agendamiento de citas en tiempo real, directorio de especialistas certificados, descarga de resultados clínicos y confirmación vía WhatsApp."
>
  <!-- Top Demo Disclaimer Header -->
  <div class="bg-slate-900 text-white text-xs py-2.5 px-4 font-mono sticky top-0 z-50 shadow-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <img src="/images/palkiotech-emblem.png" alt="PalkioTech" class="w-4 h-4 object-contain" />
        <span class="font-bold text-white">PRODUCTO DE PRODUCCIÓN PALKIOTECH:</span>
        <span class="text-slate-300 hidden md:inline">Portal Médico Institucional & Motor de Agendamiento con IA</span>
      </div>
      <div class="flex items-center gap-3">
        <a href="/#demos" class="text-amber-400 hover:text-white underline transition-colors flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Volver al Portafolio
        </a>
        <a href="/#contacto" class="bg-gradient-to-r from-amber-500 via-amber-600 to-yellow-600 hover:from-amber-600 hover:to-yellow-700 text-slate-950 font-black px-3 py-1 rounded text-[11px] transition-all flex items-center gap-1 shadow-xs">
          <span>Cotizar Este Portal Clínico</span>
          <svg class="w-3.5 h-3.5 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Medical Top Notification Bar -->
  <div class="bg-blue-950 text-slate-300 text-xs py-2 px-4 border-b border-blue-900/60 font-sans">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
      <div class="flex flex-wrap items-center gap-4 text-[11px]">
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Sede Chicó Norte: Calle 127 # 14-45 · Sede Santa Bárbara: Cra 7 # 118-20
        </span>
        <span class="text-blue-700 hidden md:inline">|</span>
        <span class="text-emerald-400 font-mono font-medium">
          ● Triaje Virtual & Citas WhatsApp 24/7 Activo
        </span>
      </div>

      <div class="flex items-center gap-3 text-[11px] font-mono">
        <a href="#portal-laboratorio" class="text-blue-300 hover:text-white underline">
          Descargar Resultados de Laboratorio
        </a>
        <span class="text-blue-700">|</span>
        <span class="text-slate-400">Emergencias: (601) 745-9000</span>
      </div>
    </div>
  </div>

  <!-- Main Medical Header -->
  <header class="bg-white border-b border-slate-200 sticky top-10 z-40 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-blue-600 text-white flex items-center justify-center font-bold text-2xl shadow-md shadow-blue-500/20 ring-2 ring-blue-100">
          ✚
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-black text-lg tracking-tight text-slate-900 block leading-tight">
              SALUD TOTAL
            </span>
            <span class="bg-emerald-100 text-emerald-800 text-[10px] font-mono font-bold px-2 py-0.5 rounded-full border border-emerald-200">
              REPS Habilitado
            </span>
          </div>
          <span class="text-xs text-slate-500 font-medium">
            Centro Médico de Especialistas & Diagnóstico Integral
          </span>
        </div>
      </div>

      <nav class="hidden lg:flex items-center gap-7 text-xs font-bold text-slate-600">
        <a href="#agendamiento" class="hover:text-blue-600 transition-colors">Agendar Cita</a>
        <a href="#especialistas" class="hover:text-blue-600 transition-colors">Directorio Médico</a>
        <a href="#especialidades" class="hover:text-blue-600 transition-colors">Especialidades</a>
        <a href="#portal-laboratorio" class="hover:text-blue-600 transition-colors">Resultados en Línea</a>
        <a href="#convenios" class="hover:text-blue-600 transition-colors">Aseguradoras & EPS</a>
      </nav>

      <div class="flex items-center gap-3">
        <a 
          href="#agendamiento"
          class="inline-flex items-center gap-2 text-xs font-bold px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white shadow-sm transition-all"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span>Apartar Cita Médica</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Medical Hero Section with Fast Booking Engine -->
  <section class="relative bg-gradient-to-b from-blue-50/60 via-white to-slate-50/80 py-12 lg:py-16 px-4 sm:px-6 lg:px-8 border-b border-slate-200 overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Hero Left: Value Proposition -->
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100/80 border border-blue-200 text-blue-800 text-xs font-bold font-mono">
          <span class="w-2 h-2 rounded-full bg-blue-600"></span>
          <span>SISTEMA CLÍNICO DIGITAL DE ALTA PRECISIÓN</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-[1.15]">
          Tu salud en manos de especialistas certificados, <span class="text-blue-600">sin filas ni esperas.</span>
        </h1>

        <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-xl">
          Selecciona tu especialista, escoge tu franja horaria en tiempo real y recibe tu <strong>Pase Digital de Cita con código QR</strong> y confirmación automática en WhatsApp en menos de 60 segundos.
        </p>

        <!-- Metric Badges Grid -->
        <div class="grid grid-cols-3 gap-3 p-4 rounded-2xl bg-white border border-slate-200 shadow-xs max-w-lg text-center sm:text-left">
          <div class="p-2">
            <span class="text-2xl font-black text-blue-700 font-mono block">+35</span>
            <span class="text-xs text-slate-500 font-medium">Médicos Titulares</span>
          </div>
          <div class="p-2 border-x border-slate-100">
            <span class="text-2xl font-black text-emerald-600 font-mono block">&lt; 60s</span>
            <span class="text-xs text-slate-500 font-medium">Tiempo de Agendamiento</span>
          </div>
          <div class="p-2">
            <span class="text-2xl font-black text-slate-900 font-mono block">99.6%</span>
            <span class="text-xs text-slate-500 font-medium">Puntualidad en Citas</span>
          </div>
        </div>

        <!-- Trust Features -->
        <div class="space-y-2 pt-2 text-xs text-slate-600">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>Recordatorios automáticos por WhatsApp 24h y 2h antes de tu consulta.</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>Aceptamos medicina prepagada, pólizas de salud y tarifa particular.</span>
          </div>
        </div>
      </div>

      <!-- Hero Right: Interactive 3-Step Booking Engine Card -->
      <div id="agendamiento" class="lg:col-span-6 bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-xl relative">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-5">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-500 animate-ping"></span>
            <h3 class="text-base font-black text-slate-900">Agendar Cita en Línea</h3>
          </div>
          <span class="text-xs font-mono font-bold text-blue-700 bg-blue-50 px-2.5 py-1 rounded-lg border border-blue-200">
            Paso <span id="booking-step-num">1</span> de 2
          </span>
        </div>

        <form id="clinic-booking-form" class="space-y-4 text-xs">
          
          <!-- STEP 1: DOCTOR, SEDE & TIME SLOTS -->
          <div id="booking-step-1" class="space-y-4">
            <div>
              <label class="block font-bold text-slate-700 mb-1">1. Selecciona la Sede Clínica *</label>
              <select id="book-sede" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs text-slate-800 font-medium focus:ring-2 focus:ring-blue-600 focus:outline-none">
                <option value="Sede Chicó Norte (Calle 127 # 14-45)">Sede Chicó Norte · Calle 127 # 14-45</option>
                <option value="Sede Santa Bárbara (Cra 7 # 118-20)">Sede Santa Bárbara · Cra 7 # 118-20</option>
              </select>
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">2. Especialidad o Médico Especialista *</label>
              <select id="book-doctor" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs text-slate-800 font-medium focus:ring-2 focus:ring-blue-600 focus:outline-none">
                {doctorsList.map((doc) => (
                  <option value={doc.id} data-fee={doc.fee} data-name={doc.name} data-spec={doc.specialty}>
                    {doc.name} — {doc.specialty} ({doc.fee})
                  </option>
                ))}
              </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block font-bold text-slate-700 mb-1">3. Fecha Deseada *</label>
                <input 
                  type="date" 
                  id="book-date" 
                  required 
                  class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2 text-xs text-slate-800 font-mono focus:ring-2 focus:ring-blue-600 focus:outline-none"
                />
              </div>

              <div>
                <label class="block font-bold text-slate-700 mb-1">Tipo de Consulta *</label>
                <select id="book-modality" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2 text-xs text-slate-800 font-medium focus:ring-2 focus:ring-blue-600 focus:outline-none">
                  <option value="Presencial en Consultorio">Presencial en Consultorio</option>
                  <option value="Telemedicina / Videoconsulta HD">Telemedicina / Videoconsulta HD</option>
                </select>
              </div>
            </div>

            <!-- Interactive Time Slots Selector -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label class="block font-bold text-slate-700">4. Franjas Horarias Disponibles *</label>
                <span class="text-[10px] font-mono text-emerald-700 font-bold">Tiempo Real</span>
              </div>
              
              <div id="time-slots-container" class="grid grid-cols-3 sm:grid-cols-5 gap-2">
                <!-- Injected via JavaScript based on doctor selected -->
              </div>
              <input type="hidden" id="selected-slot" required value="08:30 AM" />
            </div>

            <div class="pt-2">
              <button 
                type="button" 
                id="btn-goto-step-2" 
                class="w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition-all"
              >
                <span>Continuar a Datos del Paciente</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
            </div>
          </div>

          <!-- STEP 2: PATIENT DATA & MOTIVE -->
          <div id="booking-step-2" class="hidden space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block font-bold text-slate-700 mb-1">Nombre Completo del Paciente *</label>
                <input 
                  type="text" 
                  id="patient-name" 
                  required 
                  placeholder="Ej: Carolina Morales" 
                  class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-800 focus:ring-2 focus:ring-blue-600 focus:outline-none"
                />
              </div>

              <div>
                <label class="block font-bold text-slate-700 mb-1">Documento de Identidad (C.C.) *</label>
                <input 
                  type="text" 
                  id="patient-doc" 
                  required 
                  placeholder="Ej: 1.020.849.201" 
                  class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-800 focus:ring-2 focus:ring-blue-600 focus:outline-none"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block font-bold text-slate-700 mb-1">WhatsApp / Teléfono Móvil *</label>
                <input 
                  type="tel" 
                  id="patient-phone" 
                  required 
                  placeholder="+57 300 123 4567" 
                  class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-800 focus:ring-2 focus:ring-blue-600 focus:outline-none"
                />
              </div>

              <div>
                <label class="block font-bold text-slate-700 mb-1">Entidad de Salud / Cobertura *</label>
                <select id="patient-insurance" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-800 focus:ring-2 focus:ring-blue-600 focus:outline-none">
                  <option value="Particular (Sin Seguro)">Particular (Pago Directo)</option>
                  <option value="Colmédica Medicina Prepagada">Colmédica Medicina Prepagada</option>
                  <option value="Colsanitas / Medisanitas">Colsanitas / Medisanitas</option>
                  <option value="SURA Póliza de Salud">SURA Póliza de Salud</option>
                  <option value="Allianz Seguros Salud">Allianz Seguros</option>
                  <option value="Coomeva Medicina Prepagada">Coomeva Prepagada</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block font-bold text-slate-700 mb-1">Motivo Principal de Consulta o Síntomas</label>
              <textarea 
                id="patient-motive" 
                rows="2" 
                placeholder="Ej: Chequeo preventivo anual, dolor torácico ocasional..." 
                class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-800 focus:ring-2 focus:ring-blue-600 focus:outline-none"
              ></textarea>
            </div>

            <!-- Booking Summary Box -->
            <div class="bg-blue-50/70 p-3.5 rounded-xl border border-blue-200 text-xs text-blue-900 space-y-1">
              <div class="flex justify-between font-bold">
                <span id="summary-doc-spec">Dr. Sebastián Montenegro</span>
                <span id="summary-doc-fee" class="text-blue-700">$180.000 COP</span>
              </div>
              <div class="text-[11px] text-blue-800">
                <span id="summary-date-time">Fecha: Mañana a las 08:30 AM</span> · <span id="summary-sede">Sede Chicó Norte</span>
              </div>
            </div>

            <div class="flex items-center gap-2 pt-2">
              <button 
                type="button" 
                id="btn-back-step-1" 
                class="px-4 py-3 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-100 font-bold transition-all"
              >
                ← Volver
              </button>
              <button 
                type="submit" 
                class="flex-1 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition-all"
              >
                <span>Generar Pase Médico & Confirmar en WhatsApp</span>
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
