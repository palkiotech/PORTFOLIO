  // State
  let currentRouteKey = 'bogota-melgar';
  let departureMinutes = 420; // 07:00 AM (420 min from midnight)
  let currentTransportMode = 'moto';
  let isRouteAccepted = false;
  let isFavorite = false;

  // Formatting helpers
  function minutesToTimeString(mins: number): string {
    const h24 = Math.floor(mins / 60) % 24;
    const m = Math.floor(mins % 60);
    const period = h24 >= 12 ? 'PM' : 'AM';
    const h12 = h24 % 12 === 0 ? 12 : h24 % 12;
    const padM = m < 10 ? `0${m}` : `${m}`;
    return `${h12}:${padM} ${period}`;
  }

  function minutesTo24Clock(mins: number): string {
    const h24 = Math.floor(mins / 60) % 24;
    const m = Math.floor(mins % 60);
    const padH = h24 < 10 ? `0${h24}` : `${h24}`;
    const padM = m < 10 ? `0${m}` : `${m}`;
    return `${padH}:${padM}`;
  }

  function renderCheckpoints() {
    const route = routesData[currentRouteKey];
    const listEl = document.getElementById('checkpoints-list');
    if (!listEl) return;

    const isOptimalWindow = departureMinutes >= 540; // >= 09:00 AM

    listEl.innerHTML = route.checkpoints.map((cp, idx) => {
      const etaMins = departureMinutes + (currentTransportMode === 'bici' ? Math.round(cp.etaMinutes * 1.8) : cp.etaMinutes);
      const etaStr = minutesToTimeString(etaMins);
      const weather = isOptimalWindow ? cp.weatherHour930am : cp.weatherHour7am;
      const colorBg = weather.color === 'blue' 
        ? 'bg-blue-950/70 text-cyan-300 border-blue-800' 
        : (weather.color === 'yellow' ? 'bg-amber-950/70 text-amber-300 border-amber-800' : 'bg-emerald-950/70 text-emerald-300 border-emerald-800');

      return `
        <div class="p-1.5 rounded-lg bg-slate-950/70 border border-slate-800 flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="text-xs">${weather.icon}</span>
            <div>
              <span class="font-bold text-white text-[9px] block">${cp.name}</span>
              <span class="text-slate-400 text-[8px]">${etaStr} · ${cp.distanceKm} km · ${cp.elevation}m</span>
            </div>
          </div>
          <div class="text-right">
            <span class="text-[9px] font-bold text-white">${weather.temp}°C</span>
            <span class="px-1.5 py-0.2 rounded text-[7px] border font-bold block ${colorBg}">${weather.pop}% lluvia</span>
          </div>
        </div>
      `;
    }).join('');
  }

  function updateAppUI() {
    const route = routesData[currentRouteKey];
    const isOptimalWindow = departureMinutes >= 540; // >= 09:00 AM
    
    // Multipliers for bicycle vs moto
    const durationMultiplier = currentTransportMode === 'bici' ? 1.8 : 1.0;
    const totalDuration = Math.round(route.durationMinutes * durationMultiplier);
    const durationH = Math.floor(totalDuration / 60);
    const durationM = totalDuration % 60;
    const arrivalMinutes = departureMinutes + totalDuration;

    // Dom elements
    const originEl = document.getElementById('app-origin-name');
    const destEl = document.getElementById('app-destination-name');
    const sliderLabel = document.getElementById('slider-time-label');
    const phoneClock = document.getElementById('phone-clock');
    const summaryDep = document.getElementById('summary-departure-time');
    const summaryEta = document.getElementById('summary-eta-time');
    const summaryDur = document.getElementById('summary-total-duration');
    const summaryDist = document.getElementById('summary-total-distance');
    const verdictBanner = document.getElementById('verdict-banner');
    const verdictIcon = document.getElementById('verdict-icon');
    const verdictTitle = document.getElementById('verdict-title');
    const verdictDesc = document.getElementById('verdict-desc');
    const metricRain = document.getElementById('metric-rain-km');
    const smartAdviceText = document.getElementById('smart-advice-text');
    const recPill = document.getElementById('slider-recommendation-pill');
    const fusaIcon = document.getElementById('checkpoint-fusa-icon');
    const fusaTemp = document.getElementById('checkpoint-fusa-temp');
    const seg2 = document.getElementById('seg-2');

    // Values
    if (originEl) originEl.textContent = route.origin;
    if (destEl) destEl.textContent = route.destination;

    const timeString = minutesToTimeString(departureMinutes);
    if (sliderLabel) sliderLabel.textContent = timeString;
    if (phoneClock) phoneClock.textContent = minutesTo24Clock(departureMinutes);
    if (summaryDep) summaryDep.textContent = timeString;
    if (summaryEta) summaryEta.textContent = minutesToTimeString(arrivalMinutes);
    if (summaryDur) summaryDur.textContent = `${durationH}h ${durationM}m`;
    if (summaryDist) summaryDist.textContent = `${route.distanceKm} km`;

    // Dynamic Weather condition based on Departure Hour
    if (isOptimalWindow) {
      // DRY WINDOW (>= 09:00 AM)
      if (recPill) {
        recPill.className = "text-[8px] font-mono text-emerald-400 bg-emerald-950/70 border border-emerald-800 px-2 py-0.5 rounded-full font-bold";
        recPill.textContent = "☀️ Calzada 100% Seca";
      }

      if (verdictBanner) {
        verdictBanner.className = "p-2 rounded-xl bg-emerald-950/40 border border-emerald-700/50 flex items-start gap-2";
      }
      if (verdictIcon) verdictIcon.textContent = "☀️";
      if (verdictTitle) {
        verdictTitle.className = "text-[10px] font-bold text-emerald-300 leading-tight";
        verdictTitle.textContent = "100% Calzada Seca (Excelente Adherencia)";
      }
      if (verdictDesc) {
        verdictDesc.textContent = "Visibilidad despejada y asfalto sin agua en todo el recorrido hacia " + route.destination + ". Óptima temperatura de neumáticos.";
      }
      if (metricRain) {
        metricRain.textContent = "0 km";
        metricRain.className = "font-bold text-emerald-400";
      }

      if (smartAdviceText) {
        smartAdviceText.innerHTML = `<strong class="text-white">Excelente elección:</strong> Salir a las <span class="text-emerald-300 font-bold">${timeString}</span> te garantiza transitar toda la cordillera bajo condiciones secas.`;
      }

      if (fusaIcon) fusaIcon.textContent = "⛅";
      if (fusaTemp) {
        fusaTemp.textContent = "23°C · Seco";
        fusaTemp.className = "text-[7px] font-mono text-emerald-400 font-bold";
      }

      if (seg2) seg2.setAttribute('stroke', '#10b981'); // Turn map route green!

    } else {
      // RAIN IN ROUTE (< 09:00 AM)
      if (recPill) {
        recPill.className = "text-[8px] font-mono text-amber-400 bg-amber-950/70 border border-amber-800 px-2 py-0.5 rounded-full";
        recPill.textContent = "⚠️ Lluvia en Cordillera";
      }

      if (verdictBanner) {
        verdictBanner.className = "p-2 rounded-xl bg-blue-950/40 border border-blue-700/50 flex items-start gap-2";
      }
      if (verdictIcon) verdictIcon.textContent = "🌧️";
      if (verdictTitle) {
        verdictTitle.className = "text-[10px] font-bold text-cyan-300 leading-tight";
        verdictTitle.textContent = "32 km con lluvia (27% del trayecto)";
      }
      if (verdictDesc) {
        verdictDesc.textContent = "Se proyectan tramos mojados en el descenso. Conduce con impermeable y extrema precaución en curvas.";
      }
      if (metricRain) {
        metricRain.textContent = "32 km";
        metricRain.className = "font-bold text-cyan-300";
      }

      if (smartAdviceText) {
        smartAdviceText.innerHTML = `<strong class="text-white">Consejo ClimaRoute:</strong> Si demoras tu salida a las <span class="text-cyan-300 font-bold">09:30 AM</span> evitas el 100% de la lluvia en Fusagasugá y viajas con asfalto seco.`;
      }

      if (fusaIcon) fusaIcon.textContent = "🌧️";
      if (fusaTemp) {
        fusaTemp.textContent = "21°C · Lluvia";
        fusaTemp.className = "text-[7px] font-mono text-blue-300 font-bold";
      }

      if (seg2) seg2.setAttribute('stroke', '#0284c7'); // Turn map route blue (rain)
    }

    renderCheckpoints();
  }

  // Initialize event listeners when DOM loads
  document.addEventListener('DOMContentLoaded', () => {
    
    // Slider Listener
    const slider = document.getElementById('departure-slider') as HTMLInputElement | null;
    if (slider) {
      slider.addEventListener('input', (e) => {
        departureMinutes = parseInt((e.target as HTMLInputElement).value, 10);
        updateAppUI();
      });
    }

    // Steppers (-15m / +15m)
    document.getElementById('btn-step-minus')?.addEventListener('click', () => {
      departureMinutes = Math.max(360, departureMinutes - 15);
      if (slider) slider.value = `${departureMinutes}`;
      updateAppUI();
    });

    document.getElementById('btn-step-plus')?.addEventListener('click', () => {
      departureMinutes = Math.min(840, departureMinutes + 15);
      if (slider) slider.value = `${departureMinutes}`;
      updateAppUI();
    });

    // Preset Buttons (Rain at 07:00 AM vs Dry at 09:30 AM)
    document.getElementById('preset-rain')?.addEventListener('click', () => {
      departureMinutes = 420; // 07:00 AM
      if (slider) slider.value = "420";
      updateAppUI();
    });

    document.getElementById('preset-dry')?.addEventListener('click', () => {
      departureMinutes = 570; // 09:30 AM
      if (slider) slider.value = "570";
      updateAppUI();
    });

    // Mode Toggle (Moto vs Bici)
    const modeMotoBtn = document.getElementById('app-mode-moto');
    const modeBiciBtn = document.getElementById('app-mode-bici');
    const islandIcon = document.getElementById('island-icon');

    modeMotoBtn?.addEventListener('click', () => {
      currentTransportMode = 'moto';
      modeMotoBtn.className = "profile-mode-btn active px-2 py-0.5 rounded-md bg-cyan-600 text-white transition-all cursor-pointer";
      if (modeBiciBtn) modeBiciBtn.className = "profile-mode-btn px-2 py-0.5 rounded-md text-slate-400 hover:text-white transition-all cursor-pointer";
      if (islandIcon) islandIcon.textContent = "🏍️";
      updateAppUI();
    });

    modeBiciBtn?.addEventListener('click', () => {
      currentTransportMode = 'bici';
      modeBiciBtn.className = "profile-mode-btn active px-2 py-0.5 rounded-md bg-cyan-600 text-white transition-all cursor-pointer";
      if (modeMotoBtn) modeMotoBtn.className = "profile-mode-btn px-2 py-0.5 rounded-md text-slate-400 hover:text-white transition-all cursor-pointer";
      if (islandIcon) islandIcon.textContent = "🚴";
      updateAppUI();
    });

    // Route Switching (Quick chips in phone & buttons on desktop companion)
    const setupRouteButtons = () => {
      const allChips = document.querySelectorAll('.quick-route-chip, .desktop-route-btn');
      allChips.forEach((btn) => {
        btn.addEventListener('click', () => {
          const routeKey = btn.getAttribute('data-route');
          if (routeKey && routesData[routeKey]) {
            currentRouteKey = routeKey;
            
            // update phone chips visual
            document.querySelectorAll('.quick-route-chip').forEach(c => {
              if (c.getAttribute('data-route') === routeKey) {
                c.className = "quick-route-chip active px-2 py-0.5 rounded-full bg-cyan-950 text-cyan-300 border border-cyan-700 shrink-0";
              } else {
                c.className = "quick-route-chip px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700 shrink-0";
              }
            });

            // update desktop buttons visual
            document.querySelectorAll('.desktop-route-btn').forEach(d => {
              if (d.getAttribute('data-route') === routeKey) {
                d.className = "desktop-route-btn p-2 rounded-xl bg-cyan-600 text-white font-bold border border-cyan-400 transition-all cursor-pointer text-left";
              } else {
                d.className = "desktop-route-btn p-2 rounded-xl bg-slate-800 text-slate-300 hover:text-white border border-slate-700 transition-all cursor-pointer text-left";
              }
            });

            updateAppUI();
          }
        });
      });
    };
    setupRouteButtons();

    // Toggle Checkpoints Drawer
    const btnToggleCheckpoints = document.getElementById('btn-toggle-checkpoints');
    const checkpointsDrawer = document.getElementById('checkpoints-drawer');
    btnToggleCheckpoints?.addEventListener('click', () => {
      if (checkpointsDrawer) {
        checkpointsDrawer.classList.toggle('hidden');
      }
    });

    // Accept Route Button Interaction
    const btnAcceptRoute = document.getElementById('btn-accept-route');
    const acceptBtnIcon = document.getElementById('accept-btn-icon');
    const acceptBtnText = document.getElementById('accept-btn-text');
    const routeStatusTitle = document.getElementById('route-status-title');
    const routeStatusDot = document.getElementById('route-status-dot');

    btnAcceptRoute?.addEventListener('click', () => {
      isRouteAccepted = !isRouteAccepted;
      if (isRouteAccepted) {
        btnAcceptRoute.className = "flex-1 py-2 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-black text-[11px] shadow-lg shadow-emerald-600/30 transition-all flex items-center justify-center gap-1.5 cursor-pointer";
        if (acceptBtnIcon) acceptBtnIcon.textContent = "🚀";
        if (acceptBtnText) acceptBtnText.textContent = "RUTA FIJADA • NAVEGANDO";
        if (routeStatusTitle) {
          routeStatusTitle.textContent = "RUTA ACEPTADA • VIAJE EN CURSO";
          routeStatusTitle.className = "font-bold text-emerald-400 uppercase";
        }
        if (routeStatusDot) {
          routeStatusDot.className = "w-2 h-2 rounded-full bg-emerald-400 animate-ping";
        }
      } else {
        btnAcceptRoute.className = "flex-1 py-2 px-3 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-black text-[11px] shadow-lg shadow-cyan-600/30 transition-all flex items-center justify-center gap-1.5 cursor-pointer";
        if (acceptBtnIcon) acceptBtnIcon.textContent = "✅";
        if (acceptBtnText) acceptBtnText.textContent = "ACEPTAR ESTA RUTA";
        if (routeStatusTitle) {
          routeStatusTitle.textContent = "ESTIMACIÓN DEL VIAJE (PARA ACEPTAR)";
          routeStatusTitle.className = "font-bold text-cyan-300 uppercase";
        }
        if (routeStatusDot) {
          routeStatusDot.className = "w-2 h-2 rounded-full bg-cyan-400 animate-pulse";
        }
      }
    });

    // Save Favorite
    const btnSaveRoute = document.getElementById('btn-save-route');
    btnSaveRoute?.addEventListener('click', () => {
      isFavorite = !isFavorite;
      if (btnSaveRoute) {
        btnSaveRoute.textContent = isFavorite ? '★ Guardada' : '☆ Guardar';
        btnSaveRoute.className = isFavorite ? 'text-amber-400 font-bold' : 'text-slate-400 hover:text-amber-400 transition-colors';
      }
    });

    // Push Notification Simulation
    const btnTriggerPush = document.getElementById('btn-trigger-push');
    const pushNotification = document.getElementById('phone-push-notification');
    btnTriggerPush?.addEventListener('click', () => {
      if (!pushNotification) return;
      pushNotification.classList.remove('hidden');
      setTimeout(() => {
        pushNotification.classList.remove('opacity-0', '-translate-y-4');
        pushNotification.classList.add('opacity-100', 'translate-y-0');
      }, 50);

      // Auto dismiss after 4 seconds
      setTimeout(() => {
        pushNotification.classList.remove('opacity-100', 'translate-y-0');
        pushNotification.classList.add('opacity-0', '-translate-y-4');
        setTimeout(() => pushNotification.classList.add('hidden'), 300);
      }, 4000);
    });

    // Initial render
    updateAppUI();
  });
</script>
