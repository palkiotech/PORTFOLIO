  btnSendProposalWa?.addEventListener('click', () => {
    if (!activeLeadId) return;
    const lead = crmData.find(l => l.id === activeLeadId);
    if (!lead) return;

    const phoneClean = lead.phone.replace(/[^0-9]/g, '');
    let msg = `📄 *PROPUESTA FORMAL SOW — PALKIOTECH*\n`;
    msg += `------------------------------------\n`;
    msg += `👤 *Cliente:* ${lead.name}\n`;
    msg += `🏢 *Empresa:* ${lead.company}\n`;
    msg += `💼 *Solución:* ${lead.service}\n`;
    msg += `💵 *Inversión Total:* ${lead.estimatedValue}\n`;
    msg += `🛡️ *Garantía:* 30 días SLA + Repositorio Git Transferido\n`;
    msg += `------------------------------------\n`;
    msg += `Estimado ${lead.name.split(' ')[0]}, adjunto le presentamos la propuesta formal estructurada según su requerimiento. Quedamos atentos para coordinar la llamada de inicio.`;

    const url = `https://api.whatsapp.com/send?phone=${phoneClean}&text=${encodeURIComponent(msg)}`;
    window.open(url, '_blank');
  });
