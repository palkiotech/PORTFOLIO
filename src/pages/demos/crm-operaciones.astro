          <td class="py-2.5 px-3 text-right font-mono font-bold text-slate-900">$${part3.toLocaleString()} USD</td>
        </tr>
      `;
    }

    if (sowSubtotal) sowSubtotal.textContent = `$${totalVal.toLocaleString()} USD`;
    if (sowTotal) sowTotal.textContent = `$${totalVal.toLocaleString()} USD`;

    modalProposal?.classList.remove('hidden');
  }

  btnDrawerProposal?.addEventListener('click', () => {
