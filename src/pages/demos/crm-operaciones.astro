  <!-- Toast Notification Feedback -->
  <div id="crm-toast" class="fixed bottom-6 right-6 z-50 bg-slate-900 text-white text-xs font-medium px-4 py-3 rounded-xl shadow-xl border border-slate-800 flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
    <span id="crm-toast-text">Acción ejecutada correctamente</span>
  </div>

  <!-- Client-side Interactive CRM Engine -->
  <script define:vars={{ initialCrmLeads }}>
  let crmData = [...initialCrmLeads];
  let activeLeadId = null;

  // DOM Elements
  const colNuevo = document.getElementById('col-nuevo');
  const colContactado = document.getElementById('col-contactado');
  const colPropuesta = document.getElementById('col-propuesta');
  const colCerrado = document.getElementById('col-cerrado');

  const badgeCountNuevo = document.getElementById('badge-count-nuevo');
  const badgeCountContactado = document.getElementById('badge-count-contactado');
  const badgeCountPropuesta = document.getElementById('badge-count-propuesta');
  const badgeCountCerrado = document.getElementById('badge-count-cerrado');
  const kpiTotalLeads = document.getElementById('kpi-total-leads');
  const kpiTotalVal = document.getElementById('kpi-total-val');

  // Drawer Elements
  const drawer = document.getElementById('lead-drawer');
  const drawerBackdrop = document.getElementById('lead-drawer-backdrop');
  const btnCloseDrawer = document.getElementById('btn-close-drawer');
  const drawerStageSelect = document.getElementById('drawer-stage-select');
  const drawerChatBubbles = document.getElementById('drawer-chat-bubbles');
  const chatSimInput = document.getElementById('chat-sim-input');
  const btnChatSimSend = document.getElementById('btn-chat-sim-send');
  const newNoteText = document.getElementById('new-note-text');
  const btnAddNote = document.getElementById('btn-add-note');
  const drawerNotesList = document.getElementById('drawer-notes-list');

  // View Switcher Elements
  const btnViewKanban = document.getElementById('view-mode-kanban');
  const btnViewTable = document.getElementById('view-mode-table');
  const containerKanban = document.getElementById('crm-kanban-container');
  const containerTable = document.getElementById('crm-table-container');
  const tableLeadsBody = document.getElementById('table-leads-body');

  // Global Search
  const globalSearch = document.getElementById('global-lead-search');

  // Channel filters
  const filterBtns = document.querySelectorAll('.crm-channel-filter');

  // Create Modal Elements
  const btnOpenCreate = document.getElementById('btn-open-create-modal');
  const modalCreate = document.getElementById('modal-create-lead');
  const btnCloseCreate = document.getElementById('btn-close-create-modal');
  const btnCancelCreate = document.getElementById('btn-cancel-create');
  const formCreate = document.getElementById('form-create-lead');

  // Toast
  const toast = document.getElementById('crm-toast');
  const toastText = document.getElementById('crm-toast-text');

  function showToast(msg) {
    if (!toast || !toastText) return;
    toastText.textContent = msg;
    toast.classList.remove('translate-y-20', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');
    setTimeout(() => {
      toast.classList.add('translate-y-20', 'opacity-0');
      toast.classList.remove('translate-y-0', 'opacity-100');
    }, 2800);
  }

  // Update KPI counters
  function updateCounters() {
    const countNuevo = crmData.filter(l => l.stage === 'nuevo').length;
    const countContactado = crmData.filter(l => l.stage === 'contactado').length;
    const countPropuesta = crmData.filter(l => l.stage === 'propuesta').length;
    const countCerrado = crmData.filter(l => l.stage === 'cerrado').length;

    if (badgeCountNuevo) badgeCountNuevo.textContent = String(countNuevo);
    if (badgeCountContactado) badgeCountContactado.textContent = String(countContactado);
    if (badgeCountPropuesta) badgeCountPropuesta.textContent = String(countPropuesta);
    if (badgeCountCerrado) badgeCountCerrado.textContent = String(countCerrado);

    if (kpiTotalLeads) kpiTotalLeads.textContent = `${crmData.length} Prospectos`;

    const totalVal = crmData.reduce((acc, l) => acc + (l.numericValue || 0), 0);
    if (kpiTotalVal) kpiTotalVal.textContent = `$${totalVal.toLocaleString()} USD`;
  }

  // Render Table View
  function renderTableView() {
    if (!tableLeadsBody) return;
    tableLeadsBody.innerHTML = '';

    crmData.forEach(lead => {
      const tr = document.createElement('tr');
      tr.className = "hover:bg-slate-50 transition-colors cursor-pointer";
      tr.setAttribute('data-id', lead.id);

      const stageLabels = {
        nuevo: '<span class="px-2 py-0.5 rounded bg-blue-100 text-blue-800 font-mono font-bold text-[10px]">1. Nuevo</span>',
        contactado: '<span class="px-2 py-0.5 rounded bg-amber-100 text-amber-800 font-mono font-bold text-[10px]">2. En Diagnóstico</span>',
        propuesta: '<span class="px-2 py-0.5 rounded bg-indigo-100 text-indigo-800 font-mono font-bold text-[10px]">3. Propuesta</span>',
        cerrado: '<span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-mono font-bold text-[10px]">4. Ganado</span>'
      };

      tr.innerHTML = `
        <td class="py-3 px-4">
          <strong class="text-slate-900 block font-bold">${lead.name}</strong>
          <span class="text-slate-500 text-[11px]">${lead.company}</span>
        </td>
        <td class="py-3 px-4 font-mono">
          <span class="text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-bold">${lead.channel}</span>
        </td>
        <td class="py-3 px-4 text-slate-700 font-medium">
          ${lead.service}
        </td>
        <td class="py-3 px-4 font-mono font-bold text-emerald-700">
          ★ ${lead.aiScore}/100
        </td>
        <td class="py-3 px-4">
          ${stageLabels[lead.stage] || lead.stage}
        </td>
        <td class="py-3 px-4 font-mono font-black text-slate-900 text-right">
          ${lead.estimatedValue}
        </td>
        <td class="py-3 px-4 text-center">
          <button class="px-2.5 py-1 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white font-bold transition-all text-[11px]">
            Ver Chat
          </button>
        </td>
      `;

      tr.addEventListener('click', () => openLeadDrawer(lead.id));
      tableLeadsBody.appendChild(tr);
    });
  }

  // Open Lead Drawer
  function openLeadDrawer(leadId) {
    const lead = crmData.find(l => l.id === leadId);
    if (!lead) return;
    activeLeadId = leadId;

    // Populate Drawer Header
    const dName = document.getElementById('drawer-lead-name');
    const dCompany = document.getElementById('drawer-lead-company');
    const dId = document.getElementById('drawer-lead-id');
    const dChannel = document.getElementById('drawer-lead-channel');
    const dVal = document.getElementById('drawer-lead-val');
    const cCustName = document.getElementById('chat-customer-name');
    const cCustPhone = document.getElementById('chat-customer-phone');

    if (dName) dName.textContent = lead.name;
    if (dCompany) dCompany.textContent = lead.company;
    if (dId) dId.textContent = `#${lead.id.toUpperCase()}`;
    if (dChannel) dChannel.textContent = `${lead.channel} Sync`;
    if (dVal) dVal.textContent = lead.estimatedValue;
    if (cCustName) cCustName.textContent = lead.name;
    if (cCustPhone) cCustPhone.textContent = `${lead.phone} · Sincronizado`;

    if (drawerStageSelect) {
      drawerStageSelect.value = lead.stage;
    }

    // Populate Chat Bubbles
    renderChatBubbles(lead);

    // Populate AI Tab
    const aiScoreBadge = document.getElementById('ai-tab-score-badge');
    const aiIntent = document.getElementById('ai-tab-intent');
    const aiSummary = document.getElementById('ai-tab-summary');
    const aiPainPoints = document.getElementById('ai-tab-pain-points');

    if (aiScoreBadge) aiScoreBadge.textContent = `Score: ${lead.aiScore} / 100`;
    if (aiIntent) aiIntent.textContent = `Intención: ${lead.aiIntent}`;
    if (aiSummary) aiSummary.textContent = lead.aiSummary;

    if (aiPainPoints) {
      aiPainPoints.innerHTML = '';
      (lead.painPoints || []).forEach(pt => {
        const li = document.createElement('li');
        li.className = "flex items-start gap-2 bg-slate-50 p-2 rounded-lg border border-slate-200/60";
        li.innerHTML = `
          <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>${pt}</span>
        `;
        aiPainPoints.appendChild(li);
      });
    }

    // Populate Notes List
    renderNotesList(lead);

    // Show Drawer
    drawer?.classList.remove('translate-x-full');
    drawerBackdrop?.classList.remove('hidden');
  }

  function renderChatBubbles(lead) {
    if (!drawerChatBubbles) return;
    drawerChatBubbles.innerHTML = '';

    lead.chatHistory.forEach(msg => {
      const bubble = document.createElement('div');
      if (msg.sender === 'user') {
        bubble.className = "flex flex-col items-start max-w-[85%]";
        bubble.innerHTML = `
          <div class="bg-white p-3 rounded-2xl rounded-tl-none shadow-xs border border-slate-200/80 text-xs text-slate-800">
            <span class="text-[10px] font-bold text-slate-500 block mb-0.5">${lead.name}</span>
            <p class="leading-relaxed">${msg.text}</p>
            <span class="text-[9px] font-mono text-slate-400 block text-right mt-1">${msg.time}</span>
          </div>
        `;
      } else if (msg.sender === 'bot') {
        bubble.className = "flex flex-col items-end max-w-[85%] ml-auto";
        bubble.innerHTML = `
          <div class="bg-[#dcf8c6] p-3 rounded-2xl rounded-tr-none shadow-xs border border-emerald-200 text-xs text-slate-900">
            <div class="flex items-center justify-between gap-2 mb-0.5">
              <span class="text-[10px] font-bold text-emerald-800">Bot IA PalkioTech</span>
              <span class="text-[9px] bg-emerald-200/80 text-emerald-900 px-1 rounded font-mono">Automático</span>
            </div>
            <p class="leading-relaxed">${msg.text}</p>
            <span class="text-[9px] font-mono text-emerald-800 block text-right mt-1">${msg.time} ✓✓</span>
          </div>
        `;
      } else {
        bubble.className = "flex flex-col items-end max-w-[85%] ml-auto";
        bubble.innerHTML = `
          <div class="bg-blue-50 p-3 rounded-2xl rounded-tr-none shadow-xs border border-blue-200 text-xs text-slate-900">
            <span class="text-[10px] font-bold text-blue-800 block mb-0.5">Asesor Humano PalkioTech</span>
            <p class="leading-relaxed">${msg.text}</p>
            <span class="text-[9px] font-mono text-blue-700 block text-right mt-1">${msg.time} ✓✓</span>
          </div>
        `;
      }
      drawerChatBubbles.appendChild(bubble);
    });

    // Auto scroll down
    drawerChatBubbles.scrollTop = drawerChatBubbles.scrollHeight;
  }

  function renderNotesList(lead) {
    if (!drawerNotesList) return;
    drawerNotesList.innerHTML = '';

    (lead.notes || []).forEach(note => {
      const card = document.createElement('div');
      card.className = "bg-white p-3.5 rounded-xl border border-slate-200 shadow-xs text-xs";
      card.innerHTML = `
        <div class="flex items-center justify-between gap-2 mb-1">
          <strong class="text-slate-900 font-bold">${note.author}</strong>
          <span class="text-[10px] font-mono text-slate-400">${note.time}</span>
        </div>
        <p class="text-slate-600 leading-relaxed">${note.text}</p>
      `;
      drawerNotesList.appendChild(card);
    });
  }

  function closeLeadDrawer() {
    drawer?.classList.add('translate-x-full');
    drawerBackdrop?.classList.add('hidden');
    activeLeadId = null;
  }

  btnCloseDrawer?.addEventListener('click', closeLeadDrawer);
  drawerBackdrop?.addEventListener('click', closeLeadDrawer);

  // Send new response in simulated chat
  btnChatSimSend?.addEventListener('click', () => {
    const text = chatSimInput?.value.trim();
    if (!text || !activeLeadId) return;

    const lead = crmData.find(l => l.id === activeLeadId);
    if (!lead) return;

    lead.chatHistory.push({
      sender: 'agent',
      time: 'Justo ahora',
      text: text
    });

    chatSimInput.value = '';
    renderChatBubbles(lead);
    showToast("Respuesta enviada a la conversación de WhatsApp.");
  });

  // Add internal note
  btnAddNote?.addEventListener('click', () => {
    const text = newNoteText?.value.trim();
    if (!text || !activeLeadId) return;

    const lead = crmData.find(l => l.id === activeLeadId);
    if (!lead) return;

    if (!lead.notes) lead.notes = [];
    lead.notes.unshift({
      author: "Asesor PalkioTech",
      time: "Justo ahora",
      text: text
    });

    newNoteText.value = '';
    renderNotesList(lead);
    showToast("Nota interna registrada en el expediente.");
  });

  // Change stage from drawer dropdown
  drawerStageSelect?.addEventListener('change', (e) => {
    if (!activeLeadId) return;
    const newStage = e.target.value;
    const lead = crmData.find(l => l.id === activeLeadId);
    if (!lead) return;

    lead.stage = newStage;

    // Move Card in DOM Kanban
    const cardEl = document.querySelector(`.lead-card[data-id="${activeLeadId}"]`);
    const targetCol = document.getElementById(`col-${newStage}`);
    if (cardEl && targetCol) {
      targetCol.prepend(cardEl);
    }

    updateCounters();
    renderTableView();
    showToast(`Lead movido a la etapa: ${newStage.toUpperCase()}`);
  });

