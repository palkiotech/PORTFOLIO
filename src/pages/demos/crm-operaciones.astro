const totalPipelineValue = initialCrmLeads.reduce((acc, l) => acc + l.numericValue, 0);
---

<Layout 
  title="PalkioTech LeadHub | Panel Administrativo & CRM de Operaciones B2B"
  description="Software de gestión comercial en tiempo real: sincronización con WhatsApp Business API, calificación inteligente de prospectos y control operativo de ventas."
>
  <!-- Top Demo Disclaimer Header -->
  <div class="bg-slate-900 text-white text-xs py-2.5 px-4 font-mono sticky top-0 z-50 shadow-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <img src="/images/palkiotech-emblem.png" alt="PalkioTech" class="w-4 h-4 object-contain" />
        <span class="font-bold text-white">PRODUCTO DE PRODUCCIÓN PALKIOTECH:</span>
        <span class="text-slate-300 hidden md:inline">Centro de Operaciones LeadHub · CRM B2B & WhatsApp Automation</span>
      </div>
      <div class="flex items-center gap-3">
        <a href="/#demos" class="text-amber-400 hover:text-white underline transition-colors flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Volver al Portafolio
        </a>
        <a href="/#contacto" class="bg-gradient-to-r from-amber-500 via-amber-600 to-yellow-600 hover:from-amber-600 hover:to-yellow-700 text-slate-950 font-black px-3 py-1 rounded text-[11px] transition-all flex items-center gap-1 shadow-xs">
          <span>Cotizar Este Software</span>
          <svg class="w-3.5 h-3.5 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- App Header & Navigation Bar -->
  <header class="bg-white border-b border-slate-200 sticky top-10 z-40 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <img src="/images/palkiotech-emblem.png" alt="PalkioTech" class="w-10 h-10 object-contain drop-shadow" />
        <div>
          <div class="flex items-center gap-2">
            <span class="font-black text-base text-slate-900 tracking-tight block leading-tight">
              PALKIOTECH LEADHUB
            </span>
            <span class="bg-amber-50 text-amber-900 text-[10px] font-mono font-bold px-2 py-0.5 rounded-full border border-amber-200">
              v2.4 PROD
            </span>
          </div>
          <span class="text-xs text-slate-500 font-medium">
            Panel Operativo de Ventas & WhatsApp Intelligence
          </span>
        </div>
      </div>

      <!-- Quick Action Controls -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Search bar inside header -->
        <div class="relative hidden md:block w-64">
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input 
            type="text" 
            id="global-lead-search" 
            placeholder="Buscar por cliente, empresa..." 
            class="w-full pl-9 pr-3 py-1.5 rounded-lg bg-slate-100 border border-slate-200 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition-all font-sans"
          />
        </div>

        <!-- Export CSV Button -->
        <button 
          id="btn-export-csv"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-all border border-slate-300 shadow-xs"
          title="Descargar reporte en Excel / CSV"
        >
          <svg class="w-4 h-4 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span class="hidden sm:inline">Exportar CSV</span>
        </button>

        <!-- New Manual Lead Button -->
        <button 
          id="btn-open-create-modal"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition-all shadow-xs"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span class="hidden sm:inline">Nuevo Prospecto</span>
        </button>

        <!-- Live Simulation Inbound Webhook Button -->
        <button 
          id="btn-simulate-new-lead"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-all shadow-sm ring-2 ring-emerald-400/20"
        >
          <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
          <span>Simular Lead WhatsApp</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Metric KPIs Bar (Financial & Operational Executive Dash) -->
  <div class="bg-slate-50/80 border-b border-slate-200 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        
        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-mono font-bold uppercase text-slate-500">Pipeline Activo</span>
            <span class="w-2 h-2 rounded-full bg-blue-600"></span>
          </div>
          <span id="kpi-total-leads" class="text-2xl font-black text-slate-900 font-mono block">
            {initialCrmLeads.length} Prospectos
          </span>
          <span class="text-[11px] text-emerald-600 font-medium flex items-center gap-1 mt-1">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
            </svg>
            +3 calificados por IA hoy
          </span>
        </div>

        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-mono font-bold uppercase text-slate-500">Valor Negociación</span>
            <span class="text-[11px] font-mono text-emerald-600 font-bold bg-emerald-50 px-1.5 rounded">USD</span>
          </div>
          <span id="kpi-total-val" class="text-2xl font-black text-blue-700 font-mono block">
            ${totalPipelineValue.toLocaleString()} USD
          </span>
          <span class="text-[11px] text-slate-500 font-medium block mt-1">
            Ticket promedio: <strong class="text-slate-700">${Math.round(totalPipelineValue / initialCrmLeads.length).toLocaleString()} USD</strong>
          </span>
        </div>

        <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-mono font-bold uppercase text-slate-500">Respuesta Inicial IA</span>
            <span class="text-[10px] font-mono text-emerald-700 bg-emerald-100 font-bold px-1.5 py-0.5 rounded">24/7 SLA</span>
          </div>
          <span class="text-2xl font-black text-emerald-600 font-mono block">
            &lt; 30 Segundos
          </span>
