      { author: "IA PalkioTech", time: "11:48 PM", text: "Lead autocalificado con 94 puntos. Dispone de presupuesto y dolor operativo claro." },
      { author: "Ing. Soporte PalkioTech", time: "Hoy 08:15 AM", text: "Revisar integración con API de Google Calendar y enviar demo personalizada." }
    ]
  },
  {
    id: "lead-02",
