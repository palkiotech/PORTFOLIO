---
import Layout from '../../layouts/Layout.astro';

// Base de datos de prospectos hiperrealistas con historial de chat WhatsApp, calificación de IA y notas
const initialCrmLeads = [
  {
    id: "lead-01",
    name: "Dr. Roberto Valenzuela",
    company: "Clínica Odontológica Especializada Sonrisas",
    phone: "+57 312 849 2031",
    email: "roberto.valenzuela@sonrisasclinica.com",
    service: "Agente IA WhatsApp 24/7 + Agendamiento",
    channel: "WhatsApp",
    estimatedValue: "$2,400 USD",
    numericValue: 2400,
    stage: "nuevo",
    date: "Hace 6 min",
    aiScore: 94,
    aiScoreColor: "text-emerald-700 bg-emerald-50 border-emerald-200",
    aiIntent: "Urgencia Alta · Contratación Inmediata",
    aiSummary: "La clínica pierde el 45% de pacientes nocturnos y de fin de semana porque la recepcionista no responde a tiempo. Requieren un agente inteligente en WhatsApp conectado a Google Calendar / Dentalsoft para agendar citas automáticamente.",
