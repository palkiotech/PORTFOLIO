  // Export CSV
  const btnExportCsv = document.getElementById('btn-export-csv');
  btnExportCsv?.addEventListener('click', () => {
    let csvContent = "data:text/csv;charset=utf-8,";
    csvContent += "ID,Nombre,Empresa,Telefono,Email,Servicio,Canal,Valor_USD,Etapa,Score_IA\n";

    crmData.forEach(l => {
      const row = [
        l.id,
        `"${l.name}"`,
        `"${l.company}"`,
        `"${l.phone}"`,
        `"${l.email}"`,
        `"${l.service}"`,
        l.channel,
        l.numericValue,
        l.stage,
        l.aiScore
      ].join(",");
      csvContent += row + "\n";
    });

    const encodedUri = encodeURI(csvContent);
    const link = document.createElement("a");
    link.setAttribute("href", encodedUri);
    link.setAttribute("download", `PalkioTech_Leads_Report_${new Date().toISOString().slice(0, 10)}.csv`);
    document.body.appendChild(link);
    link.click();
