---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { caseStudiesData } from '../../data/caseStudies';
---

<Layout 
  title="Casos de Éxito de Producción | PalkioTech"
  description="Casos reales de ingeniería de software, arquitectura web de alta velocidad, automatizaciones de IA y optimización de datos en producción."
>
  <Navbar />
  
  <main class="min-h-screen bg-slate-50 py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb & Header -->
      <div class="mb-12">
        <nav class="flex items-center gap-2 text-xs font-mono text-slate-500 mb-4">
          <a href="/" class="hover:text-amber-600 transition-colors">Inicio</a>
          <span>/</span>
          <span class="text-amber-700 font-bold">Casos de Éxito</span>
        </nav>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 border border-amber-200 text-amber-900 text-xs font-mono font-bold mb-4">
          <span>✦ INGENIERÍA VERIFICABLE EN PRODUCCIÓN</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-5">
          Casos de Éxito: <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-600 via-amber-500 to-yellow-600">Problemas Críticos, Soluciones Reales</span>
        </h1>
        
        <p class="text-slate-600 text-base sm:text-lg max-w-3xl leading-relaxed">
          Explora cómo estructuramos, programamos y desplegamos infraestructuras digitales para empresas reales: desde tiendas web de carga instantánea y pipelines de datos masivos, hasta agentes autónomos en WhatsApp y portales médicos seguros.
        </p>
      </div>

      <!-- Quick Metrics Summary Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-6 rounded-2xl bg-white border border-slate-200 shadow-xs mb-12">
        <div class="border-r border-slate-100 last:border-0 pr-4">
          <span class="text-2xl sm:text-3xl font-extrabold text-amber-600 font-mono block">&lt; 0.8s</span>
          <span class="text-xs text-slate-600 font-medium">Tiempo de Carga Promedio</span>
        </div>
        <div class="border-r border-slate-100 last:border-0 pr-4">
          <span class="text-2xl sm:text-3xl font-extrabold text-emerald-600 font-mono block">100%</span>
          <span class="text-xs text-slate-600 font-medium">Propiedad del Código Fuente</span>
        </div>
        <div class="border-r border-slate-100 last:border-0 pr-4">
          <span class="text-2xl sm:text-3xl font-extrabold text-amber-600 font-mono block">24/7</span>
          <span class="text-xs text-slate-600 font-medium">Automatización Autónoma</span>
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-extrabold text-indigo-600 font-mono block">0%</span>
          <span class="text-xs text-slate-600 font-medium">Comisiones por Intermediación</span>
        </div>
      </div>

      <!-- Filter Controls -->
      <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 text-xs font-semibold" id="category-filters">
        <button class="filter-btn active px-4 py-2 rounded-xl bg-amber-500 text-slate-950 font-black shadow-xs" data-filter="all">
          Todos los Casos ({caseStudiesData.length})
        </button>
        <button class="filter-btn px-4 py-2 rounded-xl bg-white text-slate-700 border border-slate-200 hover:border-amber-400 hover:text-amber-700" data-filter="Móvil">
          Apps Móviles & GPS
        </button>
        <button class="filter-btn px-4 py-2 rounded-xl bg-white text-slate-700 border border-slate-200 hover:border-amber-400 hover:text-amber-700" data-filter="Retail">
          Retail & E-Commerce
        </button>
        <button class="filter-btn px-4 py-2 rounded-xl bg-white text-slate-700 border border-slate-200 hover:border-amber-400 hover:text-amber-700" data-filter="B2B">
          B2B & Operaciones CRM
        </button>
        <button class="filter-btn px-4 py-2 rounded-xl bg-white text-slate-700 border border-slate-200 hover:border-amber-400 hover:text-amber-700" data-filter="Salud">
          HealthTech & Medicina
        </button>
        <button class="filter-btn px-4 py-2 rounded-xl bg-white text-slate-700 border border-slate-200 hover:border-amber-400 hover:text-amber-700" data-filter="Inteligencia">
          IA & Microservicios
        </button>
      </div>

      <!-- Case Studies List -->
      <div class="space-y-10" id="case-studies-container">
        {caseStudiesData.map((study) => (
          <article 
            id={study.id} 
            class="case-card rounded-3xl bg-white border border-slate-200 p-6 sm:p-10 hover:border-amber-300 transition-all shadow-xs hover:shadow-md"
            data-badge={study.badge}
            data-industry={study.clientIndustry}
          >
            <!-- Header of Card -->
            <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6 mb-8">
              <div class="max-w-3xl">
                <div class="flex flex-wrap items-center gap-2.5 mb-3">
                  <span class="text-xs font-mono font-bold uppercase tracking-wider text-amber-800 bg-amber-50 px-3 py-1 rounded-full border border-amber-200">
                    {study.badge}
                  </span>
                  <span class="text-xs text-slate-500 font-medium">
                    {study.clientIndustry}
                  </span>
                  {study.liveDemoUrl && (
                    <span class="text-[11px] font-mono font-bold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded border border-emerald-200 flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                      Demo Operativa en Vivo
                    </span>
                  )}
                </div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-snug">
                  {study.title}
                </h2>
              </div>

              <!-- Top Right Action -->
              <div class="flex items-center gap-3 shrink-0">
                {study.liveDemoUrl && (
                  <a 
                    href={study.liveDemoUrl}
                    target="_blank"
                    class="inline-flex items-center gap-2 text-xs font-bold px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white shadow-xs transition-all"
                  >
                    <span>Probar Sistema en Vivo</span>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                )}
                <a 
                  href="/#contacto"
                  class="inline-flex items-center gap-2 text-xs font-bold px-4 py-2.5 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 transition-all"
                >
                  <span>Cotizar Solución</span>
                </a>
              </div>
            </div>

            <!-- Problem & Engineering Solution Box -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
              <div class="p-6 rounded-2xl bg-rose-50/50 border border-rose-200">
                <div class="flex items-center gap-2 mb-2">
                  <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                  <span class="text-xs font-mono font-bold text-rose-800 uppercase tracking-wider">
                    El Desafío / Cuello de Botella
                  </span>
                </div>
                <p class="text-sm text-slate-700 leading-relaxed">
                  {study.problem}
                </p>
              </div>

              <div class="p-6 rounded-2xl bg-emerald-50/50 border border-emerald-200">
                <div class="flex items-center gap-2 mb-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span class="text-xs font-mono font-bold text-emerald-800 uppercase tracking-wider">
                    Nuestra Arquitectura de Ingeniería
                  </span>
                </div>
                <p class="text-sm text-slate-700 leading-relaxed">
                  {study.solution}
                </p>
              </div>
            </div>

            <!-- Impact Metrics Row -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8 p-6 rounded-2xl bg-slate-50 border border-slate-200">
              {study.impactMetrics.map((metric) => (
                <div class="text-center p-3 bg-white rounded-xl border border-slate-100 shadow-2xs">
                  <span class="text-3xl sm:text-4xl font-extrabold text-amber-600 font-mono block">
                    {metric.value}
                  </span>
                  <span class="text-xs text-slate-600 font-medium leading-tight block mt-1">
                    {metric.label}
                  </span>
                </div>
              ))}
            </div>

            <!-- Full Story Deep Dive (if available) -->
            {study.fullStory && (
              <div class="mb-8 p-6 rounded-2xl bg-slate-900 text-white">
                <span class="text-xs font-mono text-emerald-400 uppercase tracking-wider font-bold block mb-2">
                  ✦ Desglose Técnico en Profundidad
                </span>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                  <div>
                    <h4 class="text-xs font-bold text-slate-300 font-mono mb-1 uppercase tracking-wider">Contexto Inicial & Diagnóstico:</h4>
                    <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
                      {study.fullStory.background}
                    </p>
                  </div>
                  <div>
                    <h4 class="text-xs font-bold text-slate-300 font-mono mb-1 uppercase tracking-wider">Patrón Arquitectónico Implementado:</h4>
                    <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
                      {study.fullStory.architecture}
                    </p>
                  </div>
                </div>

                <div class="pt-4 border-t border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <blockquote class="italic text-xs text-slate-300 border-l-2 border-emerald-400 pl-3">
                    "{study.fullStory.quote}"
                    <footer class="text-[11px] text-slate-500 font-normal not-italic mt-0.5">
                      — {study.fullStory.quoteAuthor}
                    </footer>
                  </blockquote>
                  <span class="text-[11px] font-mono text-emerald-400 shrink-0">
                    Impacto: {study.fullStory.results.slice(0, 80)}...
                  </span>
                </div>
              </div>
            )}

            <!-- Key Highlights and Tech Stack -->
            <div class="pt-6 border-t border-slate-100 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
              <div>
                <span class="text-xs font-mono font-bold text-slate-500 block mb-2 uppercase tracking-wider">
                  Tecnologías & Protocolos Aplicados:
                </span>
                <div class="flex flex-wrap gap-2">
                  {study.techStack.map((tech) => (
                    <span class="text-xs font-mono text-slate-700 bg-slate-100 px-3 py-1 rounded-lg border border-slate-200">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <div class="flex items-center gap-3">
                <a 
                  href="/#contacto" 
                  class="text-xs font-bold text-amber-700 hover:text-amber-900 transition-colors inline-flex items-center gap-1.5"
                >
                  <span>Replicar esta arquitectura en mi empresa</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                </a>
              </div>
            </div>

          </article>
        ))}
      </div>

      <!-- Bottom CTA Banner -->
      <div class="mt-16 p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-slate-950 via-slate-900 to-amber-950/40 border border-amber-500/20 text-white shadow-xl flex flex-col md:flex-row items-center justify-between gap-8">
        <div>
          <span class="text-xs font-mono text-emerald-400 uppercase tracking-wider font-bold block mb-2">
            ✦ Tu Proyecto Puede Ser Nuestro Siguiente Caso de Éxito
          </span>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white mb-2">
            ¿Tienes un cuello de botella técnico que resolver?
          </h3>
          <p class="text-sm text-slate-300 max-w-xl leading-relaxed">
            Agenda una llamada de diagnóstico técnico de 30 minutos sin costo. Evaluaremos tu arquitectura actual, calcularemos el alcance exacto y te entregaremos un plan de acción con presupuesto cerrado.
          </p>
        </div>
        <div class="shrink-0 flex flex-col sm:flex-row gap-3 w-full md:w-auto">
          <a 
            href="/#contacto"
            class="text-center text-sm font-bold px-6 py-3.5 rounded-xl bg-gradient-to-r from-amber-500 via-amber-600 to-yellow-600 hover:from-amber-600 hover:to-yellow-700 text-slate-950 font-black shadow-md shadow-amber-500/20 transition-all"
          >
            Agendar Diagnóstico Técnico
          </a>
          <a 
            href="/blueprint"
            class="text-center text-xs font-mono font-bold px-5 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition-all flex items-center justify-center gap-2"
          >
            <span>Ver Blueprint Técnico ↗</span>
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  // Simple client-side category filter
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const caseCards = document.querySelectorAll('.case-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-amber-500', 'text-slate-950', 'font-black', 'shadow-xs');
          b.classList.add('bg-white', 'text-slate-700');
        });
        btn.classList.add('bg-amber-500', 'text-slate-950', 'font-black', 'shadow-xs');
        btn.classList.remove('bg-white', 'text-slate-700');

        const filter = btn.getAttribute('data-filter') || 'all';

        caseCards.forEach(card => {
          const badge = card.getAttribute('data-badge') || '';
          const industry = card.getAttribute('data-industry') || '';
          const combined = (badge + ' ' + industry).toLowerCase();

          if (filter === 'all') {
            card.style.display = 'block';
          } else if (filter === 'Móvil' && (combined.includes('móvil') || combined.includes('movil') || combined.includes('geolocalización') || combined.includes('dos ruedas') || combined.includes('climaroute'))) {
            card.style.display = 'block';
          } else if (filter === 'Retail' && (combined.includes('retail') || combined.includes('pharma') || combined.includes('comercial'))) {
            card.style.display = 'block';
          } else if (filter === 'B2B' && (combined.includes('b2b') || combined.includes('crm') || combined.includes('operaciones'))) {
            card.style.display = 'block';
          } else if (filter === 'Salud' && (combined.includes('salud') || combined.includes('farmacéutico') || combined.includes('médic'))) {
            card.style.display = 'block';
          } else if (filter === 'Inteligencia' && (combined.includes('inteligencia') || combined.includes('observabilidad') || combined.includes('api'))) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>
