---
import { companyData } from '../data/company';
---

<header id="main-header" data-theme="light" class="sticky top-0 z-50 w-full backdrop-blur-md transition-all duration-200">
  <!-- Reading Progress Bar (Subtle 2px indicator filling as user scrolls) -->
  <div id="scroll-progress-bar" class="absolute bottom-0 left-0 h-[2px] bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-500 w-0 transition-all duration-75"></div>

  <div id="header-container" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 transition-all duration-200 flex items-center justify-between gap-4">
    
    <!-- Brand Identity (Adaptive Contrast Wordmark) -->
    <a href="/#hero" class="flex items-center gap-3 shrink-0 group focus:outline-none focus:ring-2 focus:ring-amber-500/40 rounded-xl py-1">
      <img 
        src="/images/palkiotech-emblem.png" 
        alt="PalkioTech" 
        class="h-9 w-auto object-contain drop-shadow-sm group-hover:scale-105 transition-transform" 
      />
      <div class="flex flex-col">
        <div class="flex items-center gap-1.5 leading-none">
          <span class="font-black text-xl tracking-tight">
            <span id="brand-palkio">PALKIO</span><span id="brand-tech">TECH</span>
          </span>
        </div>
        <span id="brand-subtitle" class="text-[8px] font-mono tracking-[0.22em] font-bold uppercase mt-0.5">
          INNOVATION &bull; ENGINEERING
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links (Adaptive Dynamic Contrast) -->
    <nav class="hidden xl:flex items-center gap-6 text-xs font-semibold shrink-0">
      <a href="/#soluciones" class="nav-link whitespace-nowrap py-1">
        Soluciones
      </a>

      <!-- Dedicated PalkioTag™ (Google 5★ & NFC) Link -->
      <a href="/PalkioTag/" class="nav-link flex items-center gap-1.5 whitespace-nowrap py-1 font-bold">
        <span>PalkioTag™</span>
        <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded nav-badge-amber">5★ GOOGLE</span>
      </a>
      
      <a href="/#demos" class="nav-link flex items-center gap-1.5 whitespace-nowrap py-1">
        <span>Productos Demo</span>
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      </a>

      <a href="/casos" class="nav-link flex items-center gap-1.5 whitespace-nowrap py-1">
        <span>Casos de Éxito</span>
        <span class="text-[10px] font-mono px-1 rounded nav-badge-amber">7</span>
      </a>

      <a href="/blueprint" class="nav-link flex items-center gap-1 whitespace-nowrap py-1 font-bold">
        <span>Blueprint Técnico</span>
        <span class="text-[9px] font-mono font-bold px-1 py-0.2 rounded nav-badge-amber">DOCS</span>
      </a>

      <a href="/faq#equipo" class="nav-link whitespace-nowrap py-1">
        Equipo
      </a>

      <a href="/faq" class="nav-link whitespace-nowrap py-1">
        FAQ
      </a>
    </nav>

    <!-- Header Actions (CTA Button) -->
    <div class="flex items-center gap-3 shrink-0">
      <a 
        href="/#contacto" 
        class="inline-flex items-center gap-2 text-xs font-black px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 via-amber-500 to-yellow-500 hover:from-amber-500 hover:to-yellow-600 text-slate-950 shadow-md shadow-amber-500/25 hover:shadow-lg hover:shadow-amber-500/35 hover:scale-105 transition-all focus:outline-none focus:ring-2 focus:ring-amber-500 whitespace-nowrap"
      >
        <span>Agendar Diagnóstico</span>
        <svg class="w-3.5 h-3.5 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>

      <!-- Mobile/Tablet Menu Toggle Button (Visible below XL: 1280px) -->
      <button 
        id="mobile-menu-btn"
        aria-label="Toggle Navigation Menu"
        class="xl:hidden p-2 rounded-xl focus:outline-none transition-colors border"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile / Tablet Dropdown Menu -->
  <div id="mobile-menu" class="hidden xl:hidden border-b px-5 pt-3 pb-6 space-y-2.5 shadow-xl transition-all">
    <div class="grid grid-cols-2 gap-2 pb-3 border-b border-black/10 dark:border-white/10 text-xs font-semibold">
      <a href="/#soluciones" class="p-2 rounded-lg mobile-link mobile-nav-link">Soluciones B2B</a>
      <a href="/PalkioTag/" class="p-2 rounded-lg flex items-center justify-between mobile-link mobile-nav-link font-bold text-amber-500">
        <span>PalkioTag™ (Google 5★)</span>
        <span class="text-[9px] font-mono px-1.5 py-0.5 rounded nav-badge-amber">5★ GOOGLE</span>
      </a>
      <a href="/#demos" class="p-2 rounded-lg flex items-center justify-between mobile-link mobile-nav-link">
        <span>Productos Demo</span>
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      </a>
      <a href="/casos" class="p-2 rounded-lg flex items-center justify-between mobile-link mobile-nav-link">
        <span>Casos de Éxito</span>
        <span class="text-[10px] font-mono px-1.5 rounded nav-badge-amber">7</span>
      </a>
      <a href="/PalkioTag/#simulador" class="p-2 rounded-lg mobile-link mobile-nav-link">Simulador NFC & 5★</a>
      <a href="/faq#equipo" class="p-2 rounded-lg mobile-link mobile-nav-link">Equipo & Cultura</a>
      <a href="/faq" class="p-2 rounded-lg mobile-link mobile-nav-link">Preguntas Frecuentes</a>
    </div>

    <!-- Featured Blueprint Link in Mobile Menu -->
    <a 
      href="/blueprint" 
      class="flex items-center justify-between p-3 rounded-xl mobile-blueprint-box font-semibold text-xs mobile-link transition-colors"
    >
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Blueprint Técnico & Estándar de Ingeniería</span>
      </div>
      <span class="text-[10px] font-mono font-bold bg-amber-500 text-slate-950 px-2 py-0.5 rounded">DOCS ↗</span>
    </a>
  </div>
</header>

<style is:global>
  /* Base Transitions for Smooth Color Shifts */
  #main-header,
  #main-header #brand-palkio,
  #main-header #brand-tech,
  #main-header #brand-subtitle,
  #main-header .nav-link,
  #main-header .nav-badge-amber,
  #main-header #mobile-menu-btn,
  #main-header #mobile-menu,
  #main-header .mobile-nav-link {
    transition: background-color 0.22s ease, border-color 0.22s ease, color 0.22s ease, box-shadow 0.22s ease;
  }

  /* -------------------------------------------
     LIGHT THEME (OVER WHITE / CLEAR BACKGROUNDS)
     Black and dark text for crystal clear contrast
     ------------------------------------------- */
  #main-header[data-theme="light"] {
    background-color: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 0 2px 10px -2px rgba(15, 23, 42, 0.08);
  }
  #main-header[data-theme="light"] #brand-palkio {
    color: #020617; /* Deepest Charcoal Black */
  }
  #main-header[data-theme="light"] #brand-tech {
    color: #d97706; /* Rich Amber Gold */
  }
  #main-header[data-theme="light"] #brand-subtitle {
    color: #b45309; /* Warm Bronze / Amber */
  }
  #main-header[data-theme="light"] .nav-link {
    color: #334155; /* Slate-700 */
  }
  #main-header[data-theme="light"] .nav-link:hover {
    color: #d97706; /* Amber-600 */
  }
  #main-header[data-theme="light"] .nav-badge-amber {
    background-color: #fef3c7; /* Amber-100 */
    color: #92400e; /* Amber-800 */
    border: 1px solid #fcd34d; /* Amber-300 */
  }
  #main-header[data-theme="light"] #mobile-menu-btn {
    background-color: #f8fafc;
    color: #1e293b;
    border-color: #e2e8f0;
  }
  #main-header[data-theme="light"] #mobile-menu {
    background-color: rgba(255, 255, 255, 0.98);
    border-color: #e2e8f0;
  }
  #main-header[data-theme="light"] .mobile-nav-link {
    color: #334155;
  }
  #main-header[data-theme="light"] .mobile-nav-link:hover {
    background-color: #f1f5f9;
    color: #d97706;
  }
  #main-header[data-theme="light"] .mobile-blueprint-box {
    background-color: #fffbeb;
    border: 1px solid #fde68a;
    color: #92400e;
  }

  /* -------------------------------------------
     DARK THEME (OVER DARK OBSIDIAN BACKGROUNDS)
     White and gold text for luxury titanium contrast
     ------------------------------------------- */
  #main-header[data-theme="dark"] {
    background-color: rgba(8, 8, 10, 0.96);
    border-bottom: 1px solid #202028;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.6);
  }
  #main-header[data-theme="dark"] #brand-palkio {
    color: #ffffff; /* Crisp Pure White */
  }
  #main-header[data-theme="dark"] #brand-tech {
    color: #fbbf24; /* Luminous 24K Gold */
  }
  #main-header[data-theme="dark"] #brand-subtitle {
    color: rgba(251, 191, 36, 0.9);
  }
  #main-header[data-theme="dark"] .nav-link {
    color: #d4d4d8; /* Zinc-300 */
  }
  #main-header[data-theme="dark"] .nav-link:hover {
    color: #fbbf24; /* Amber-400 */
  }
  #main-header[data-theme="dark"] .nav-badge-amber {
    background-color: rgba(69, 26, 3, 0.85);
    color: #fde68a;
    border: 1px solid rgba(180, 83, 9, 0.6);
  }
  #main-header[data-theme="dark"] #mobile-menu-btn {
    background-color: #181820;
    color: #d4d4d8;
    border-color: #262630;
  }
  #main-header[data-theme="dark"] #mobile-menu {
    background-color: #0c0c10;
    border-color: #202028;
  }
  #main-header[data-theme="dark"] .mobile-nav-link {
    color: #d4d4d8;
  }
  #main-header[data-theme="dark"] .mobile-nav-link:hover {
    background-color: #181820;
    color: #fbbf24;
  }
  #main-header[data-theme="dark"] .mobile-blueprint-box {
    background-color: rgba(69, 26, 3, 0.4);
    border: 1px solid rgba(180, 83, 9, 0.6);
    color: #fde68a;
  }
</style>

<script>
  // Mobile menu toggle
  var btn = document.getElementById('mobile-menu-btn');
  var menu = document.getElementById('mobile-menu');
  var links = document.querySelectorAll('.mobile-link');
  var header = document.getElementById('main-header');
  var headerContainer = document.getElementById('header-container');
  var progressBar = document.getElementById('scroll-progress-bar');

  if (btn && menu) {
    btn.addEventListener('click', function() {
      menu.classList.toggle('hidden');
    });

    links.forEach(function(l) {
      l.addEventListener('click', function() {
        menu.classList.add('hidden');
      });
    });
  }

  // Dynamic Theme Detector based on Section Underneath Navbar
  function updateNavbarTheme() {
    if (!header) return;

    var probeY = 50; // Probe point right below navbar top
    
    // Check if entire page has dark theme attribute
    var isPageDark = document.body.getAttribute('data-page-theme') === 'dark' || 
                     (document.querySelector('main') && document.querySelector('main').getAttribute('data-page-theme') === 'dark');

    var isDark = !!isPageDark;

    // Check all tagged sections on page
    var themeElements = document.querySelectorAll('[data-navbar-theme]');
    themeElements.forEach(function(el) {
      var rect = el.getBoundingClientRect();
      if (rect.top <= probeY && rect.bottom >= probeY) {
        var mode = el.getAttribute('data-navbar-theme');
        isDark = (mode === 'dark');
      }
    });

    var targetTheme = isDark ? 'dark' : 'light';
    if (header.getAttribute('data-theme') !== targetTheme) {
      header.setAttribute('data-theme', targetTheme);
    }
  }

  // Smooth scroll handler: adjusts header height, reading progress & dynamic theme
  window.addEventListener('scroll', function() {
    var scrollY = window.scrollY || window.pageYOffset;
    
    // Dynamic theme evaluation
    updateNavbarTheme();

    // Smooth header shrink on scroll (from h-16 to h-13)
    if (scrollY > 30) {
      if (headerContainer) {
        headerContainer.classList.remove('h-16');
        headerContainer.classList.add('h-13');
      }
    } else {
      if (headerContainer) {
        headerContainer.classList.remove('h-13');
        headerContainer.classList.add('h-16');
      }
    }

    // Update reading progress bar
    if (progressBar) {
      var totalHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (totalHeight > 0) {
        var progressPercent = Math.min(100, Math.max(0, (scrollY / totalHeight) * 100));
        progressBar.style.width = progressPercent + '%';
      }
    }
  }, { passive: true });

  // Initial detection on page load
  document.addEventListener('DOMContentLoaded', updateNavbarTheme);
  setTimeout(updateNavbarTheme, 50);
</script>
