<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Tabs
    const tabGoogle = document.getElementById('tab-teaser-google');
    const tabCard = document.getElementById('tab-teaser-card');
    const tabMenu = document.getElementById('tab-teaser-menu');

    // Contents Left
    const contentGoogle = document.getElementById('content-google');
    const contentCard = document.getElementById('content-card');
    const contentMenu = document.getElementById('content-menu');

    // Mockups Right
    const mockupGoogle = document.getElementById('mockup-google');
    const mockupCard = document.getElementById('mockup-card');
    const mockupMenu = document.getElementById('mockup-menu');

    // Tap Simulation Trigger
    const btnTap = document.getElementById('btn-trigger-tap-demo');
    const toastTap = document.getElementById('toast-nfc-tap');

    function resetTabs() {
      [tabGoogle, tabCard, tabMenu].forEach(tab => {
        if (!tab) return;
        tab.className = "teaser-tab-btn px-4 py-2 rounded-xl text-xs font-mono font-bold text-zinc-400 hover:text-white transition-all flex items-center gap-1.5 cursor-pointer";
      });
      [contentGoogle, contentCard, contentMenu].forEach(c => c?.classList.add('hidden'));
      [mockupGoogle, mockupCard, mockupMenu].forEach(m => m?.classList.add('hidden'));
    }

    tabGoogle?.addEventListener('click', () => {
      resetTabs();
      tabGoogle.className = "teaser-tab-btn active px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all flex items-center gap-2 bg-gradient-to-r from-amber-500 to-yellow-600 text-slate-950 shadow-md cursor-pointer";
      contentGoogle?.classList.remove('hidden');
      mockupGoogle?.classList.remove('hidden');
    });

    tabCard?.addEventListener('click', () => {
      resetTabs();
      tabCard.className = "teaser-tab-btn active px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all flex items-center gap-2 bg-gradient-to-r from-amber-500 to-yellow-600 text-slate-950 shadow-md cursor-pointer";
      contentCard?.classList.remove('hidden');
      mockupCard?.classList.remove('hidden');
    });

    tabMenu?.addEventListener('click', () => {
      resetTabs();
      tabMenu.className = "teaser-tab-btn active px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all flex items-center gap-2 bg-gradient-to-r from-amber-500 to-yellow-600 text-slate-950 shadow-md cursor-pointer";
      contentMenu?.classList.remove('hidden');
      mockupMenu?.classList.remove('hidden');
    });

    // Tap Simulation Button Logic
    btnTap?.addEventListener('click', () => {
      if (toastTap) {
        toastTap.classList.remove('hidden');
        btnTap.classList.add('scale-95');
        setTimeout(() => {
          btnTap.classList.remove('scale-95');
        }, 150);
        setTimeout(() => {
          toastTap.classList.add('hidden');
        }, 4000);
      }
    });

    // Card Front / Back Interactive Switcher
    const btnCardSideFront = document.getElementById('btn-card-side-front');
    const btnCardSideBack = document.getElementById('btn-card-side-back');
    const cardFaceFront = document.getElementById('card-face-front');
    const cardFaceBack = document.getElementById('card-face-back');
    const btnFlipToBack = document.getElementById('btn-flip-to-back');
    const btnFlipToFront = document.getElementById('btn-flip-to-front');

    function showCardFront() {
      cardFaceFront?.classList.remove('hidden');
      cardFaceBack?.classList.add('hidden');
      btnCardSideFront?.classList.add('bg-gradient-to-r', 'from-amber-500', 'to-yellow-600', 'text-slate-950', 'font-black');
      btnCardSideFront?.classList.remove('text-zinc-400');
      btnCardSideBack?.classList.remove('bg-gradient-to-r', 'from-amber-500', 'to-yellow-600', 'text-slate-950', 'font-black');
      btnCardSideBack?.classList.add('text-zinc-400');
    }

    function showCardBack() {
      cardFaceFront?.classList.add('hidden');
      cardFaceBack?.classList.remove('hidden');
      btnCardSideBack?.classList.add('bg-gradient-to-r', 'from-amber-500', 'to-yellow-600', 'text-slate-950', 'font-black');
      btnCardSideBack?.classList.remove('text-zinc-400');
      btnCardSideFront?.classList.remove('bg-gradient-to-r', 'from-amber-500', 'to-yellow-600', 'text-slate-950', 'font-black');
      btnCardSideFront?.classList.add('text-zinc-400');
    }

    btnCardSideFront?.addEventListener('click', showCardFront);
    btnCardSideBack?.addEventListener('click', showCardBack);
    btnFlipToBack?.addEventListener('click', showCardBack);
    btnFlipToFront?.addEventListener('click', showCardFront);
  });
</script>
